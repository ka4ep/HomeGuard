# Скопируй в .env и заполни:
#   cp .env.example .env

# IP адрес домашнего сервера в локальной сети
SERVER_IP=192.168.1.100

# VAPID ключи для Web Push (генерируй один раз):
#   dotnet tool install -g webpush-keygen && webpush-keygen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# NextCloud (опционально)
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=
