# Скопируй в .env и заполни:
#   cp .env.example .env

# ── Сервер ────────────────────────────────────────────────────────────────────
# IP или hostname машины в локальной сети.
# Используется в Fido2__ServerDomain и Origins — должен совпадать с адресом в браузере.
SERVER_DOMAIN=192.168.1.100

# ── VAPID (Web Push) ──────────────────────────────────────────────────────────
# Генерация (один раз):
#   dotnet tool install -g webpush-keygen
#   webpush-keygen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@homeguard.local

# ── API-ключ для машинных клиентов ────────────────────────────────────────────
# Общий секрет: сервер (Auth__ApiKey) + инжесторы (заголовок X-Api-Key).
# Генерация: openssl rand -hex 32. Пустой = машинный доступ выключен.
HOMEGUARD_API_KEY=

# ── Одометр: портал VW EU Data Act (опционально) ──────────────────────────────
# Логин Cupra ID и GUID машины в HomeGuard (виден в URL /equipment/{guid}).
# Перед запуском создай на портале continuous-запрос "All Data" / 15 минут —
# см. tools/euda-ingestor/README.md.
EUDA_EMAIL=
EUDA_PASSWORD=
EUDA_EQUIPMENT_ID=

# ── NextCloud (опционально) ───────────────────────────────────────────────────
# Если не используешь — оставь пустыми, blobs будут храниться только локально.
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_FOLDER=HomeGuard/blobs
