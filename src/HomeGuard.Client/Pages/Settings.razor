@page "/settings"
@inject AuthApiClient      AuthApi
@inject NotificationApiClient NotificationApi
@inject OutboxSyncService  Outbox
@inject IJSRuntime         JS
@inject ISnackbar          Snackbar
@inject IDialogService     Dialog
@inject IStringLocalizer<Strings> L

<PageTitle>@L["Nav_Settings"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@L["Nav_Settings"]</MudText>

@* ── Language ──────────────────────────────────────────────────────────────── *@
<MudCard Elevation="1" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Translate" Class="mr-1" />
                @L["Settings_Language"]
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <LanguageSwitcher />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
            @L["Settings_LanguageHelp"]
        </MudText>
    </MudCardContent>
</MudCard>

@* ── Passkey devices ───────────────────────────────────────────────────────── *@
<MudCard Elevation="1" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Devices" Class="mr-1" />
                @L["Settings_Devices"]
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        @if (_credentials is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
        }
        else if (_credentials.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@L["Settings_NoDevices"]</MudAlert>
        }
        else
        {
            <MudList T="CredentialDto" Dense="true">
                @foreach (var cred in _credentials)
                {
                    <MudListItem T="CredentialDto">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body1">@cred.DeviceName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @L["Settings_DeviceAdded", ShortDate(cred.CreatedAt)]
                                    @if (cred.LastUsedAt.HasValue)
                                    {
                                        <span> · @L["Settings_DeviceLastUsed", ShortDate(cred.LastUsedAt.Value)]</span>
                                    }
                                </MudText>
                            </MudStack>
                            <MudTooltip Text="@(_credentials.Count <= 1 ? LastDeviceHint : RevokeHint)">
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               Disabled="@(_credentials.Count <= 1 || _revoking == cred.Id)"
                                               OnClick="@(() => ConfirmRevokeAsync(cred))" />
                            </MudTooltip>
                        </MudStack>
                    </MudListItem>
                    <MudDivider />
                }
            </MudList>
        }
    </MudCardContent>

    <MudCardActions>
        @if (!_addingDevice)
        {
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.AddCircleOutline"
                       OnClick="@(() => _addingDevice = true)">
                @L["Settings_AddThisDevice"]
            </MudButton>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="px-2 pb-2 w-100">
                <MudTextField @bind-Value="_newDeviceName"
                              Label=@(L["Settings_DeviceName"])
                              Placeholder=@(L["Settings_DeviceNamePlaceholder"])
                              Immediate="true"
                              Style="flex:1" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(string.IsNullOrWhiteSpace(_newDeviceName) || _registeringDevice)"
                           OnClick="AddDeviceAsync">
                    @(_registeringDevice ? L["Settings_Registering"] : L["Settings_RegisterPasskey"])
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               OnClick="@(() => _addingDevice = false)" />
            </MudStack>
        }
    </MudCardActions>
</MudCard>

@* ── Offline sync ──────────────────────────────────────────────────────────── *@
<MudCard Elevation="1" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Sync" Class="mr-1" />
                @L["Settings_OfflineSync"]
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudText>@L["Settings_PendingOperations"] <strong>@_pendingCount</strong></MudText>
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Outlined" OnClick="FlushAsync" Disabled="_flushing">
            @L["Settings_SyncNow"]
        </MudButton>
    </MudCardActions>
</MudCard>

@* ── Push notifications ────────────────────────────────────────────────────── *@
<MudCard Elevation="1" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Notifications" Class="mr-1" />
                @L["Settings_Push"]
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (_pushStatus == PushStatus.Granted)
        {
            <MudAlert Severity="Severity.Success" Dense="true">
                @L["Settings_PushGranted"]
            </MudAlert>
        }
        else if (_pushStatus == PushStatus.Denied)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @L["Settings_PushDenied"]
            </MudAlert>
        }
        else
        {
            <MudText Color="Color.Secondary">
                @L["Settings_PushExplain"]
            </MudText>
        }
    </MudCardContent>
    <MudCardActions>
        @if (_pushStatus == PushStatus.Default)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="SubscribeAsync" Disabled="_subscribing">
                @L["Settings_PushEnable"]
            </MudButton>
        }
    </MudCardActions>
</MudCard>

@code {
    private string LastDeviceHint => L["Settings_CannotRemoveLast"];
    private string RevokeHint      => L["Settings_RevokeDevice"];

    private static string ShortDate(DateTimeOffset value)
        => value.LocalDateTime.ToString("d", System.Globalization.CultureInfo.CurrentCulture);

    // ── Credentials ───────────────────────────────────────────────────────────
    private List<CredentialDto>? _credentials;
    private Guid?   _revoking;
    private bool    _addingDevice;
    private string  _newDeviceName = string.Empty;
    private bool    _registeringDevice;

    // ── Sync ──────────────────────────────────────────────────────────────────
    private int  _pendingCount;
    private bool _flushing;

    // ── Push ──────────────────────────────────────────────────────────────────
    private PushStatus _pushStatus  = PushStatus.Default;
    private bool       _subscribing;

    protected override async Task OnInitializedAsync()
    {
        _credentials  = await AuthApi.GetCredentialsAsync();
        _pendingCount = await Outbox.PendingCountAsync();
        _pushStatus   = await GetPushStatusAsync();
    }

    // ── Add device ────────────────────────────────────────────────────────────

    private async Task AddDeviceAsync()
    {
        if (string.IsNullOrWhiteSpace(_newDeviceName)) return;

        _registeringDevice = true;
        try
        {
            var optionsJson = await AuthApi.GetAddDeviceOptionsJsonAsync(_newDeviceName.Trim());
            if (optionsJson is null)
            {
                Snackbar.Add(L["Settings_RegisterStartFailed"], Severity.Error);
                return;
            }

            var attestationElement = await JS.InvokeAsync<System.Text.Json.JsonElement>(
                "homeGuardAuth.register", optionsJson);

            if (attestationElement.TryGetProperty("error", out var err))
            {
                Snackbar.Add(err.GetString() ?? L["Settings_RegisterCancelled"], Severity.Warning);
                return;
            }

            var result = await AuthApi.CompleteAddDeviceAsync(attestationElement.GetRawText());
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Settings_RegisterFailed"], Severity.Error);
                return;
            }

            Snackbar.Add(L["Settings_DeviceRegistered", _newDeviceName.Trim()], Severity.Success);
            _credentials  = await AuthApi.GetCredentialsAsync();
            _newDeviceName = string.Empty;
            _addingDevice  = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _registeringDevice = false;
        }
    }

    // ── Revoke ────────────────────────────────────────────────────────────────

    private async Task ConfirmRevokeAsync(CredentialDto cred)
    {
        var confirmed = await Dialog.ShowMessageBoxAsync(
            title: L["Settings_RevokeTitle"],
            message: L["Settings_RevokeMessage", cred.DeviceName],
            yesText: L["Common_Delete"],
            cancelText: L["Common_Cancel"]);

        if (confirmed != true) return;

        _revoking = cred.Id;
        StateHasChanged();

        var (success, error) = await AuthApi.RevokeCredentialAsync(cred.Id);
        if (success)
        {
            Snackbar.Add(L["Settings_DeviceRemoved", cred.DeviceName], Severity.Success);
            _credentials = await AuthApi.GetCredentialsAsync();
        }
        else
        {
            Snackbar.Add(error ?? L["Settings_RevokeFailed"], Severity.Error);
        }

        _revoking = null;
    }

    // ── Sync ──────────────────────────────────────────────────────────────────

    private async Task FlushAsync()
    {
        _flushing = true;
        var result = await Outbox.FlushAsync();
        _pendingCount = await Outbox.PendingCountAsync();
        _flushing = false;

        Snackbar.Add(result.HasFailures
            ? L["Settings_SyncPartial", result.Failed]
            : L["Settings_SyncDone", result.Committed],
            result.HasFailures ? Severity.Warning : Severity.Success);
    }

    // ── Push notifications ────────────────────────────────────────────────────

    private async Task<PushStatus> GetPushStatusAsync()
    {
        try
        {
            var perm = await JS.InvokeAsync<string>("homeGuardPush.getPermission");
            return perm switch
            {
                "granted" => PushStatus.Granted,
                "denied"  => PushStatus.Denied,
                _         => PushStatus.Default,
            };
        }
        catch { return PushStatus.Default; }
    }

    private async Task SubscribeAsync()
    {
        _subscribing = true;
        try
        {
            var vapidKey = await NotificationApi.GetVapidPublicKeyAsync();
            if (vapidKey is null)
            {
                Snackbar.Add(L["Settings_PushNotConfigured"], Severity.Warning);
                return;
            }

            // homeGuardPush.subscribe returns { endpoint, p256dh, auth } or null on denial.
            var sub = await JS.InvokeAsync<PushSubscriptionJs?>("homeGuardPush.subscribe", vapidKey);
            if (sub is null)
            {
                Snackbar.Add(L["Settings_PushPermissionDenied"], Severity.Warning);
                _pushStatus = PushStatus.Denied;
                return;
            }

            await NotificationApi.SubscribeAsync(sub.Endpoint, sub.P256dh, sub.Auth);
            _pushStatus = PushStatus.Granted;
            Snackbar.Add(L["Settings_PushEnabled"], Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _subscribing = false; }
    }

    private enum PushStatus { Default, Granted, Denied }
    private sealed record PushSubscriptionJs(string Endpoint, string P256dh, string Auth);
}
