@page "/equipment"
@using System.Globalization
@inject EquipmentApiClient Api
@inject WarrantyApiClient WarrantyApi
@inject NavigationManager Nav
@inject DensityPreference Density
@inject IStringLocalizer<Strings> L

<PageTitle>@L["Nav_Equipment"]</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5">@L["Nav_Equipment"]</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <DensitySwitch Surface="@DensitySurface.Equipment"
                       Mode="_density"
                       ModeChanged="OnDensityChanged" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog">
            @L["Common_Add"]
        </MudButton>
    </MudStack>
</MudStack>

<MudTextField @bind-Value="_search" Label="@SearchLabel" Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Immediate="true" Class="mb-4" />

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (!Filtered.Any())
{
    <MudText Color="Color.Secondary" Class="mt-4">
        @(string.IsNullOrWhiteSpace(_search) ? L["Equipment_Empty"] : L["Equipment_NoMatch", _search])
    </MudText>
}
else if (_density == DensityMode.Cards)
{
    <MudGrid>
        @foreach (var item in Filtered)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="1" Style="cursor:pointer"
                         @onclick="() => OpenDetail(item.Id)">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Start"
                                  Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.h6">@item.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @CategoryLabel(item.Category)
                                    @if (item.Brand is not null)
                                    {
                                        <span> · @item.Brand</span>
                                    }
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @L["Equipment_Purchased"] @ShortDate(item.PurchaseDate)
                                </MudText>
                            </div>
                            <MudIcon Icon="@CategoryIcon(item.Category)"
                                     Color="Color.Primary" Size="Size.Large" />
                        </MudStack>

                        @if (item.Tags.Count > 0)
                        {
                            <MudStack Row="true" Class="mt-2" Spacing="1">
                                @foreach (var tag in item.Tags.Take(4))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @tag
                                    </MudChip>
                                }
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudTable T="EquipmentSummary" Items="Filtered" Elevation="1"
              Dense="true" Hover="true" Striped="false"
              OnRowClick="OnRowClick">
        <HeaderContent>
            <MudTh>@L["Equipment_Name"]</MudTh>
            <MudTh>@L["Equipment_Category"]</MudTh>
            <MudTh>@L["Equipment_Purchased"]</MudTh>
            <MudTh>@L["Equipment_Tags"]</MudTh>
        </HeaderContent>
        <RowTemplate Context="item">
            <MudTd DataLabel="@NameLabel" Style="cursor:pointer">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@CategoryIcon(item.Category)" Size="Size.Small"
                             Color="Color.Primary" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body2" Style="font-weight:600">@item.Name</MudText>
                        @if (item.Brand is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Brand</MudText>
                        }
                    </MudStack>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="@CategoryColumnLabel">@CategoryLabel(item.Category)</MudTd>
            <MudTd DataLabel="@PurchasedLabel" Class="hg-tabular">@ShortDate(item.PurchaseDate)</MudTd>
            <MudTd DataLabel="@TagsLabel">
                @if (item.Tags.Count > 0)
                {
                    <MudStack Row="true" Spacing="1" Style="flex-wrap:wrap">
                        @foreach (var tag in item.Tags.Take(4))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                        }
                    </MudStack>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<!-- Add dialog -->
<MudDialog @bind-Visible="_showAdd">
    <TitleContent>@L["Equipment_AddTitle"]</TitleContent>
    <DialogContent>
        <EquipmentForm Model="_form" />

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @L["Equipment_AddWarranty"]: @WarrantyFormModel.YearsLabel(L, _warrantyForm.DurationYears)
        </MudText>
        <MudSlider T="int" Value="_warrantyForm.DurationYears" ValueChanged="OnWarrantyYearsChanged"
                   Min="0" Max="10" Step="1" Color="Color.Primary" />
        <MudCollapse Expanded="_warrantyForm.DurationYears > 0">
            <MudGrid Class="mt-1">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_warrantyForm.Name" Label=@(L["Form_Name"]) Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_warrantyForm.Provider" Label=@(L["Warranty_Provider"]) />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_warrantyForm.ContractNumber" Label=@(L["Warranty_ContractNumber"]) />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_warrantyForm.Notes" Label=@(L["Form_Notes"]) Lines="2" />
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @L["Equipment_WarrantyEndsOn", ShortDate(ComputedWarrantyEnd)]
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudCollapse>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showAdd = false">@L["Common_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveAsync" Disabled="_saving">
            @L["Common_Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<EquipmentSummary>? _items;
    private string _search = string.Empty;
    private bool _showAdd;
    private bool _saving;
    private EquipmentFormModel _form = new();
    private DensityMode _density = DensityMode.Cards;

    // Most equipment gets exactly one warranty, starting on the purchase date, for a
    // round number of years — dragging the slider to 0 is "no warranty" or "I'll add it
    // later", instead of that being the default someone has to build every time.
    private WarrantyFormModel _warrantyForm = new();

    private void OnWarrantyYearsChanged(int years) => _warrantyForm.DurationYears = years;

    private DateOnly ComputedWarrantyEnd
        => _form.PurchaseDate.AddYears(_warrantyForm.DurationYears).AddDays(-1);

    // Attribute values cannot nest the localizer's own quotes, so the labels the table
    // needs in attributes are read once here.
    private string SearchLabel         => L["Common_Search"];
    private string NameLabel           => L["Equipment_Name"];
    private string CategoryColumnLabel => L["Equipment_Category"];
    private string PurchasedLabel      => L["Equipment_Purchased"];
    private string TagsLabel           => L["Equipment_Tags"];

    private IEnumerable<EquipmentSummary> Filtered
        => _items?.Where(i =>
               string.IsNullOrWhiteSpace(_search) ||
               i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
               (i.Brand?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
               i.Tags.Any(t => t.Contains(_search, StringComparison.OrdinalIgnoreCase)))
           ?? [];

    protected override async Task OnInitializedAsync()
    {
        _density = await Density.GetAsync(DensitySurface.Equipment);
        _items   = await Api.GetAllAsync() ?? [];
    }

    private void OnDensityChanged(DensityMode mode) => _density = mode;

    private void OnRowClick(TableRowClickEventArgs<EquipmentSummary> args)
    {
        if (args.Item is not null) OpenDetail(args.Item.Id);
    }

    private void OpenAddDialog()
    {
        _form         = new EquipmentFormModel();
        _warrantyForm = new WarrantyFormModel { Name = L["Warranty_DefaultName"] };
        _showAdd = true;
    }

    private void OpenDetail(Guid id) => Nav.NavigateTo($"/equipment/{id}");

    private async Task SaveAsync()
    {
        _saving = true;
        var dto = new CreateEquipmentDto(
            _form.Name, _form.Category, _form.PurchaseDate,
            _form.Brand, _form.Model, _form.SerialNumber,
            _form.PurchasePrice, _form.Notes,
            _form.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            _form.MeterUnit);

        var result = await Api.CreateAsync(dto);
        if (result is not null)
        {
            _items?.Insert(0, result);

            if (_warrantyForm.DurationYears > 0)
            {
                await WarrantyApi.CreateAsync(new CreateWarrantyDto(
                    result.Id, _warrantyForm.Name, _form.PurchaseDate, ComputedWarrantyEnd,
                    _warrantyForm.Provider, _warrantyForm.ContractNumber, _warrantyForm.Notes));
            }
        }
        _saving = false;
        _showAdd = false;
    }

    /// <summary>Category is stored as the enum name; the label it shows comes from resources.</summary>
    private string CategoryLabel(string category) => L["Category_" + category];

    private static string ShortDate(DateOnly date)
        => date.ToString("d", CultureInfo.CurrentCulture);

    private static string CategoryIcon(string category) => category switch
    {
        "Vehicle" => Icons.Material.Filled.DirectionsCar,
        "HomeAppliance" => Icons.Material.Filled.Countertops,
        "Electronics" => Icons.Material.Filled.Devices,
        "Heating" => Icons.Material.Filled.Thermostat,
        "Garden" => Icons.Material.Filled.Yard,
        "Furniture" => Icons.Material.Filled.Chair,
        _ => Icons.Material.Filled.Category,
    };
}
