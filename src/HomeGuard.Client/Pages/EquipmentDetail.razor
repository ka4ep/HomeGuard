@page "/equipment/{Id:guid}"
@using HomeGuard.Client.Common
@using Microsoft.AspNetCore.Components
@using System.Globalization
@inject EquipmentApiClient EquipmentApi
@inject NavigationManager Nav
@inject IStringLocalizer<Strings> L

<PageTitle>@(_detail?.Name ?? L["Nav_Equipment"])</PageTitle>

@if (_detail is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @* ── Header ─────────────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Nav.NavigateTo("/equipment"))" />
        <MudText Typo="Typo.h5">@_detail.Name</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Edit"    OnClick="OpenEditDialog" />
        <MudIconButton Icon="@Icons.Material.Filled.Delete"  Color="Color.Error"
                       OnClick="DeleteEquipmentAsync" />
    </MudStack>

    @* ── Info card ───────────────────────────────────────────────────────────── *@
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Equipment_Category"]</MudText>
                    <MudText>@L["Category_" + _detail.Category]</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Equipment_BrandModel"]</MudText>
                    <MudText>@(_detail.Brand ?? "—") @_detail.Model</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Form_SerialNumber"]</MudText>
                    <MudText>@(_detail.SerialNumber ?? "—")</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Equipment_Purchased"]</MudText>
                    <MudText Class="hg-tabular">@_detail.PurchaseDate.ToString("d", CultureInfo.CurrentCulture)</MudText>
                </MudItem>
                @if (_detail.PurchasePrice.HasValue)
                {
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Form_PurchasePrice"]</MudText>
                        <MudText Class="hg-tabular">@_detail.PurchasePrice.Value.ToString("N2", CultureInfo.CurrentCulture) €</MudText>
                    </MudItem>
                }
            </MudGrid>

            @if (_detail.Tags.Count > 0)
            {
                <MudStack Row="true" Class="mt-3" Spacing="1">
                    @foreach (var tag in _detail.Tags)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                    }
                </MudStack>
            }

            @if (!string.IsNullOrWhiteSpace(_detail.Notes))
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@_detail.Notes</MudText>
            }
        </MudCardContent>
    </MudCard>

    <AttachmentsCard OwnerEntityId="Id" OwnerEntityType="Equipment"
                     EmptyText="@L["Equipment_AttachmentsEmpty"]" />

    <WarrantySection EquipmentId="Id" />

    <ServiceSection EquipmentId="Id" MeterUnit="@_detail.MeterUnit"
                    EditServiceId="EditServiceId" EditRuleId="EditRuleId" />

    <MeterReadingSection Equipment="_detail" />

    <ContractSection EquipmentId="Id" />
}

@* ── Equipment edit dialog ───────────────────────────────────────────────────── *@
<MudDialog @bind-Visible="_showEdit">
    <TitleContent>@L["Equipment_EditTitle"]</TitleContent>
    <DialogContent>
        <EquipmentForm Model="_editForm" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showEdit = false">@L["Common_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveEditAsync" Disabled="_saving">@L["Common_Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid Id { get; set; }

    // Deep-link from the Timeline card: ?editService={id} / ?editRule={id} auto-opens the dialog.
    [Parameter, SupplyParameterFromQuery(Name = "editService")] public Guid? EditServiceId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "editRule")] public Guid? EditRuleId { get; set; }

    private EquipmentDetailDto? _detail;
    private bool _saving;
    private bool _showEdit;
    private EquipmentFormModel _editForm = new();

    protected override async Task OnInitializedAsync()
        => _detail = await EquipmentApi.GetAsync(Id);

    private void OpenEditDialog()
    {
        if (_detail is null) return;
        _editForm = new EquipmentFormModel
        {
            Name                 = _detail.Name,
            Category             = _detail.Category,
            Brand                = _detail.Brand,
            Model                = _detail.Model,
            SerialNumber         = _detail.SerialNumber,
            PurchasePrice        = _detail.PurchasePrice,
            Notes                = _detail.Notes,
            Tags                 = string.Join(", ", _detail.Tags),
            PurchaseDateNullable = _detail.PurchaseDate.ToDateTime(TimeOnly.MinValue),
            MeterUnit            = _detail.MeterUnit,
        };
        _showEdit = true;
    }

    private async Task SaveEditAsync()
    {
        _saving = true;
        await EquipmentApi.UpdateAsync(Id, new UpdateEquipmentDto(
            _editForm.Name, _editForm.Category, _editForm.PurchaseDate,
            _editForm.Brand, _editForm.Model, _editForm.SerialNumber,
            _editForm.PurchasePrice, _editForm.Notes, _editForm.MeterUnit));
        _detail   = await EquipmentApi.GetAsync(Id);
        _saving   = false;
        _showEdit = false;
    }

    private async Task DeleteEquipmentAsync()
    {
        await EquipmentApi.DeleteAsync(Id);
        Nav.NavigateTo("/equipment");
    }
}
