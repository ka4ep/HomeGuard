@page "/equipment/{Id:guid}"
@using HomeGuard.Client.Common
@inject EquipmentApiClient EquipmentApi
@inject WarrantyApiClient WarrantyApi
@inject ServiceRecordApiClient ServiceApi
@inject BlobApiClient BlobApi
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_detail?.Name ?? "Equipment")</PageTitle>

@if (_detail is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @* ── Header ─────────────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Nav.NavigateTo("/equipment"))" />
        <MudText Typo="Typo.h5">@_detail.Name</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Edit"    OnClick="OpenEditDialog" />
        <MudIconButton Icon="@Icons.Material.Filled.Delete"  Color="Color.Error"
                       OnClick="DeleteEquipmentAsync" />
    </MudStack>

    @* ── Info card ───────────────────────────────────────────────────────────── *@
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Category</MudText>
                    <MudText>@_detail.Category</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Brand / Model</MudText>
                    <MudText>@(_detail.Brand ?? "—") @_detail.Model</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Serial number</MudText>
                    <MudText>@(_detail.SerialNumber ?? "—")</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Purchased</MudText>
                    <MudText>@_detail.PurchaseDate.ToString("d MMM yyyy", null)</MudText>
                </MudItem>
                @if (_detail.PurchasePrice.HasValue)
                {
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Price</MudText>
                        <MudText>@_detail.PurchasePrice.Value.ToString("F2", null) €</MudText>
                    </MudItem>
                }
            </MudGrid>

            @if (_detail.Tags.Count > 0)
            {
                <MudStack Row="true" Class="mt-3" Spacing="1">
                    @foreach (var tag in _detail.Tags)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                    }
                </MudStack>
            }

            @if (!string.IsNullOrWhiteSpace(_detail.Notes))
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@_detail.Notes</MudText>
            }
        </MudCardContent>
    </MudCard>

    @* ── Warranties ──────────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" />
        <MudText Typo="Typo.h6">Warranties</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddWarrantyDialog">Add</MudButton>
    </MudStack>

    @if (_warranties.Count == 0)
    {
        <MudText Color="Color.Secondary" Class="mb-4">No warranties registered.</MudText>
    }
    else
    {
        @foreach (var w in _warranties)
        {
            <MudPaper @key="@w.Id" Elevation="1" Class="mb-1"
                      Style="border-radius:var(--hg-radius-md); overflow:hidden">
                @* Заголовок — кликабельная строка *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="px-4 py-2"
                          Style="cursor:pointer; flex-wrap:wrap"
                          @onclick="() => Toggle(_expandedW, w.Id)">
                    <MudText Typo="Typo.body1" Style="font-weight:600; flex:1">@w.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @w.StartDate.ToString("d MMM yyyy", null) → @w.EndDate.ToString("d MMM yyyy", null)
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="@WarrantyColor(w.DaysRemaining)">
                        @WarrantyLabel(w.DaysRemaining)
                    </MudChip>
                    <MudIcon Icon="@(_expandedW.Contains(w.Id)
                                    ? Icons.Material.Filled.ExpandLess
                                    : Icons.Material.Filled.ExpandMore)"
                             Color="Color.Secondary" />
                </MudStack>
                @* Детали *@
                <MudCollapse Expanded="@_expandedW.Contains(w.Id)">
                    <MudDivider />
                    <MudStack Spacing="3" Class="px-4 py-3">
                        @if (w.Provider is not null || w.ContractNumber is not null)
                        {
                            <MudStack Row="true" Spacing="4" Style="flex-wrap:wrap">
                                @if (w.Provider is not null)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Provider</MudText>
                                        <MudText Typo="Typo.body2">@w.Provider</MudText>
                                    </MudStack>
                                }
                                @if (w.ContractNumber is not null)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Contract №</MudText>
                                        <MudText Typo="Typo.body2">@w.ContractNumber</MudText>
                                    </MudStack>
                                }
                            </MudStack>
                        }
                        @if (!string.IsNullOrWhiteSpace(w.Notes))
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Notes</MudText>
                                <MudText Typo="Typo.body2" Style="white-space:pre-line">@w.Notes</MudText>
                            </MudStack>
                        }
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                           Size="Size.Small"
                                           OnClick="() => OpenEditWarrantyDialog(w)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                           Size="Size.Small" Color="Color.Error"
                                           OnClick="() => DeleteWarrantyAsync(w.Id)" />
                        </MudStack>
                    </MudStack>
                </MudCollapse>
            </MudPaper>
        }
    }

    @* ── Service records ─────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.Build" />
        <MudText Typo="Typo.h6">Service records</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddServiceDialog">Add</MudButton>
    </MudStack>

    @if (_serviceRecords.Count == 0)
    {
        <MudText Color="Color.Secondary" Class="mb-4">No service records yet.</MudText>
    }
    else
    {
        @foreach (var sr in _serviceRecords)
        {
            <MudPaper @key="@sr.Id" Elevation="1" Class="mb-1"
                      Style="border-radius:var(--hg-radius-md); overflow:hidden">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="px-4 py-2"
                          Style="cursor:pointer; flex-wrap:wrap"
                          @onclick="() => Toggle(_expandedSr, sr.Id)">
                    <MudStack Spacing="0" Style="flex:1">
                        <MudText Typo="Typo.body1" Style="font-weight:600">@sr.Title</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @sr.ServiceDate.ToString("d MMM yyyy", null)
                        </MudText>
                    </MudStack>
                    @if (sr.IsOverdue)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">Overdue</MudChip>
                    }
                    else if (sr.DaysUntilNextService.HasValue)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(sr.DaysUntilNextService <= 7 ? Color.Warning : Color.Default)">
                            @ServiceDaysLabel(sr.DaysUntilNextService)
                        </MudChip>
                    }
                    <MudIcon Icon="@(_expandedSr.Contains(sr.Id)
                                    ? Icons.Material.Filled.ExpandLess
                                    : Icons.Material.Filled.ExpandMore)"
                             Color="Color.Secondary" />
                </MudStack>
                <MudCollapse Expanded="@_expandedSr.Contains(sr.Id)">
                    <MudDivider />
                    <MudStack Spacing="3" Class="px-4 py-3">
                        <MudStack Row="true" Spacing="4" Style="flex-wrap:wrap">
                            @if (sr.Cost.HasValue)
                            {
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Cost</MudText>
                                    <MudText Typo="Typo.body2">€ @sr.Cost.Value.ToString("F2", null)</MudText>
                                </MudStack>
                            }
                            @if (sr.MeterReading.HasValue)
                            {
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Meter reading</MudText>
                                    <MudText Typo="Typo.body2">@sr.MeterReading @_detail?.MeterUnit</MudText>
                                </MudStack>
                            }
                            @if (sr.ServiceProvider is not null)
                            {
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Provider</MudText>
                                    <MudText Typo="Typo.body2">@sr.ServiceProvider</MudText>
                                </MudStack>
                            }
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(sr.Notes))
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Notes</MudText>
                                <MudText Typo="Typo.body2" Style="white-space:pre-line">@sr.Notes</MudText>
                            </MudStack>
                        }
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                           Size="Size.Small"
                                           OnClick="() => OpenEditServiceDialog(sr)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                           Size="Size.Small" Color="Color.Error"
                                           OnClick="() => DeleteServiceAsync(sr.Id)" />
                        </MudStack>
                    </MudStack>
                </MudCollapse>
            </MudPaper>
        }
    }
}

@* ── Equipment edit dialog ───────────────────────────────────────────────────── *@
<MudDialog @bind-Visible="_showEdit">
    <TitleContent>Edit equipment</TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_editForm.Name" Label="Name" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_editForm.Brand" Label="Brand" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_editForm.Model" Label="Model" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_editForm.SerialNumber" Label="Serial number" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField @bind-Value="_editForm.PurchasePrice" Label="Price"
                                 Format="F2" Adornment="Adornment.Start" AdornmentText="€" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker @bind-Date="_editForm.PurchaseDateNullable"
                               Label="Purchase date" DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_editForm.MeterUnit" Label="Meter unit (e.g. km, kWh, h)" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_editForm.Tags" Label="Tags (comma-separated)" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_editForm.Notes" Label="Notes"
                              Lines="3" Sizing="InputSizing.Auto" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showEdit = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveEditAsync" Disabled="_saving">Save</MudButton>
    </DialogActions>
</MudDialog>

@* ── Warranty add/edit dialog ────────────────────────────────────────────────── *@
<MudDialog @bind-Visible="_showAddWarranty">
    <TitleContent>@(_editWarrantyId.HasValue ? "Edit warranty" : "Add warranty")</TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_wForm.Name" Label="Name" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_wForm.StartDateNullable" Label="Start date"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_wForm.EndDateNullable" Label="End date"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_wForm.Provider" Label="Provider" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_wForm.ContractNumber" Label="Contract number" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_wForm.Notes" Label="Notes"
                              Lines="3" Sizing="InputSizing.Auto" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseWarrantyDialog">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveWarrantyAsync" Disabled="_saving">Save</MudButton>
    </DialogActions>
</MudDialog>

@* ── Service record add/edit dialog ─────────────────────────────────────────── *@
<MudDialog @bind-Visible="_showAddService">
    <TitleContent>@(_editServiceId.HasValue ? "Edit service record" : "Add service record")</TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_srForm.Title" Label="Title" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_srForm.ServiceDateNullable"
                               Label="Service date" DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_srForm.Status" Label="Status">
                    <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
                    <MudSelectItem Value="@("Planned")">Planned</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_srForm.ServiceProvider" Label="Provider" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField @bind-Value="_srForm.Cost" Label="Cost" Format="F2"
                                 Adornment="Adornment.Start" AdornmentText="€" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField @bind-Value="_srForm.MeterReading" Label="@("Meter reading" + (_detail?.MeterUnit is { Length: > 0 } u ? $" ({u})" : ""))" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_srForm.Notes" Label="Notes"
                              Lines="3" Sizing="InputSizing.Auto" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseServiceDialog">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveServiceAsync" Disabled="_saving">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid Id { get; set; }

    private EquipmentDetailDto?    _detail;
    private List<WarrantyDto>      _warranties     = [];
    private List<ServiceRecordDto> _serviceRecords = [];
    private bool _saving;

    // Dialog visibility
    private bool _showEdit;
    private bool _showAddWarranty;
    private bool _showAddService;

    // Edit IDs — null means "add new"
    private Guid? _editWarrantyId;
    private Guid? _editServiceId;

    // Form models
    private EquipmentFormModel     _editForm = new();
    private WarrantyFormModel      _wForm    = new();
    private ServiceRecordFormModel _srForm   = new();

    // Развёрнутые строки — вместо MudExpansionPanel (каскадный параметр
    // ненадёжен в сложном дереве компонентов; MudCollapse + HashSet надёжнее)
    private readonly HashSet<Guid> _expandedW  = [];
    private readonly HashSet<Guid> _expandedSr = [];

    private static void Toggle(HashSet<Guid> set, Guid id)
    {
        if (!set.Remove(id)) set.Add(id);
    }

    protected override async Task OnInitializedAsync()
        => await Task.WhenAll(LoadDetailAsync(), LoadWarrantiesAsync(), LoadServiceAsync());

    private async Task LoadDetailAsync()
        => _detail = await EquipmentApi.GetAsync(Id);

    private async Task LoadWarrantiesAsync()
        => _warranties = await WarrantyApi.GetByEquipmentAsync(Id) ?? [];

    private async Task LoadServiceAsync()
        => _serviceRecords = await ServiceApi.GetByEquipmentAsync(Id) ?? [];

    // ── Equipment ─────────────────────────────────────────────────────────────

    private void OpenEditDialog()
    {
        if (_detail is null) return;
        _editForm = new EquipmentFormModel
        {
            Name                 = _detail.Name,
            Category             = _detail.Category,
            Brand                = _detail.Brand,
            Model                = _detail.Model,
            SerialNumber         = _detail.SerialNumber,
            PurchasePrice        = _detail.PurchasePrice,
            Notes                = _detail.Notes,
            Tags                 = string.Join(", ", _detail.Tags),
            PurchaseDateNullable = _detail.PurchaseDate.ToDateTime(TimeOnly.MinValue),
            MeterUnit            = _detail.MeterUnit,
        };
        _showEdit = true;
    }

    private async Task SaveEditAsync()
    {
        _saving = true;
        await EquipmentApi.UpdateAsync(Id, new UpdateEquipmentDto(
            _editForm.Name, _editForm.Category, _editForm.PurchaseDate,
            _editForm.Brand, _editForm.Model, _editForm.SerialNumber,
            _editForm.PurchasePrice, _editForm.Notes, _editForm.MeterUnit));
        await LoadDetailAsync();
        _saving   = false;
        _showEdit = false;
    }

    private async Task DeleteEquipmentAsync()
    {
        await EquipmentApi.DeleteAsync(Id);
        Nav.NavigateTo("/equipment");
    }

    // ── Warranties ────────────────────────────────────────────────────────────

    private void OpenAddWarrantyDialog()
    {
        _editWarrantyId  = null;
        _wForm           = new WarrantyFormModel();
        _showAddWarranty = true;
    }

    private void OpenEditWarrantyDialog(WarrantyDto w)
    {
        _editWarrantyId = w.Id;
        _wForm = new WarrantyFormModel
        {
            Name              = w.Name,
            Provider          = w.Provider,
            ContractNumber    = w.ContractNumber,
            Notes             = w.Notes,
            StartDateNullable = w.StartDate.ToDateTime(TimeOnly.MinValue),
            EndDateNullable   = w.EndDate.ToDateTime(TimeOnly.MinValue),
        };
        _showAddWarranty = true;
    }

    private async Task SaveWarrantyAsync()
    {
        _saving = true;
        if (_editWarrantyId.HasValue)
        {
            await WarrantyApi.UpdateAsync(_editWarrantyId.Value, new UpdateWarrantyDto(
                _wForm.Name, _wForm.StartDate, _wForm.EndDate,
                _wForm.Provider, _wForm.ContractNumber, _wForm.Notes));
            await LoadWarrantiesAsync();
        }
        else
        {
            var result = await WarrantyApi.CreateAsync(new CreateWarrantyDto(
                Id, _wForm.Name, _wForm.StartDate, _wForm.EndDate,
                _wForm.Provider, _wForm.ContractNumber, _wForm.Notes));
            if (result is not null) _warranties.Insert(0, result);
        }
        _saving = false;
        CloseWarrantyDialog();
    }

    private async Task DeleteWarrantyAsync(Guid id)
    {
        await WarrantyApi.DeleteAsync(id);
        _warranties.RemoveAll(w => w.Id == id);
    }

    private void CloseWarrantyDialog()
    {
        _showAddWarranty = false;
        _editWarrantyId  = null;
    }

    // ── Service records ───────────────────────────────────────────────────────

    private void OpenAddServiceDialog()
    {
        _editServiceId  = null;
        _srForm         = new ServiceRecordFormModel();
        _showAddService = true;
    }

    private void OpenEditServiceDialog(ServiceRecordDto sr)
    {
        _editServiceId = sr.Id;
        _srForm = new ServiceRecordFormModel
        {
            Title               = sr.Title,
            ServiceProvider     = sr.ServiceProvider,
            Cost                = sr.Cost,
            MeterReading        = sr.MeterReading,
            Notes               = sr.Notes,
            Status              = sr.Status,
            ServiceDateNullable = sr.ServiceDate.ToDateTime(TimeOnly.MinValue),
        };
        _showAddService = true;
    }

    private async Task SaveServiceAsync()
    {
        _saving = true;
        if (_editServiceId.HasValue)
        {
            await ServiceApi.UpdateAsync(_editServiceId.Value, new UpdateServiceRecordDto(
                _srForm.Title, _srForm.ServiceDate, _srForm.Status,
                _srForm.Cost, _srForm.ServiceProvider, _srForm.Notes, _srForm.MeterReading));
            await LoadServiceAsync();
        }
        else
        {
            var result = await ServiceApi.CreateAsync(new CreateServiceRecordDto(
                Id, _srForm.Title, _srForm.ServiceDate, _srForm.Status,
                _srForm.Cost, _srForm.ServiceProvider, _srForm.Notes, _srForm.MeterReading));
            if (result is not null) _serviceRecords.Insert(0, result);
        }
        _saving = false;
        CloseServiceDialog();
    }

    private async Task DeleteServiceAsync(Guid id)
    {
        await ServiceApi.DeleteAsync(id);
        _serviceRecords.RemoveAll(sr => sr.Id == id);
    }

    private void CloseServiceDialog()
    {
        _showAddService = false;
        _editServiceId  = null;
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static Color WarrantyColor(int days) => days switch
    {
        < 0   => Color.Default,
        <= 7  => Color.Error,
        <= 30 => Color.Warning,
        _     => Color.Success,
    };

    private static string WarrantyLabel(int days) => days switch
    {
        < 0   => "Expired",
        0     => "Today",
        1     => "Tomorrow",
        <= 30 => $"{days}d left",
        _     => $"{days / 30}mo left",
    };

    private static string ServiceDaysLabel(int? days) => days switch
    {
        null  => "—",
        0     => "Today",
        1     => "Tomorrow",
        <= 30 => $"In {days}d",
        _     => $"In {days / 30}mo",
    };
}
