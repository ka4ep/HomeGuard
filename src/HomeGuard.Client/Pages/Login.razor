@page "/login"
@inject AuthApiClient AuthApi
@inject SessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<Login> Logger
@inject IStringLocalizer<Strings> L

<PageTitle>HomeGuard — @L["Nav_SignIn"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard Elevation="3">
        <MudCardContent Class="pa-6">

            <MudStack AlignItems="AlignItems.Center" Class="mb-6">
                <MudIcon Icon="@Icons.Material.Filled.Home"
                         Color="Color.Primary" Style="font-size:3rem" />
                <MudText Typo="Typo.h5">HomeGuard</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @L["Login_Subtitle"]
                </MudText>
            </MudStack>

            @if (!_supported)
            {
                <MudAlert Severity="Severity.Error">
                    @L["Login_NoPasskeySupport"]
                </MudAlert>
            }
            else
            {
                @if (_mode == Mode.Login)
                {
                    <!-- Login -->
                    <MudStack Spacing="3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   FullWidth="true" Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.Fingerprint"
                                   OnClick="LoginAsync" Disabled="_busy">
                            @(_busy ? L["Login_Authenticating"] : L["Login_SignInWithPasskey"])
                        </MudButton>

                        <MudDivider />

                        <MudText Typo="Typo.body2" Align="Align.Center"
                                 Color="Color.Secondary">
                            @L["Login_FirstTime"]
                        </MudText>

                        <MudButton Variant="Variant.Outlined" FullWidth="true"
                                   OnClick="() => _mode = Mode.Register">
                            @L["Login_Register"]
                        </MudButton>
                    </MudStack>
                }
                else
                {
                    <!-- Register -->
                    <MudStack Spacing="3">
                        <MudTextField @bind-Value="_displayName"
                                      Label=@(L["Login_YourName"])
                                      Placeholder=@(L["Login_YourNamePlaceholder"])
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />

                        <MudTextField @bind-Value="_deviceName"
                                      Label=@(L["Login_ThisDevice"])
                                      Placeholder=@(L["Login_ThisDevicePlaceholder"])
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Devices" />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   FullWidth="true" Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.AddCircle"
                                   OnClick="RegisterAsync"
                                   Disabled="_busy || string.IsNullOrWhiteSpace(_displayName)">
                            @(_busy ? L["Settings_Registering"] : L["Settings_RegisterPasskey"])
                        </MudButton>

                        <MudButton Variant="Variant.Text" FullWidth="true"
                                   OnClick="() => _mode = Mode.Login">
                            @L["Login_BackToSignIn"]
                        </MudButton>
                    </MudStack>
                }
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">
                    @_error
                </MudAlert>
            }

            @if (_devModeEnabled)
            {
                <MudDivider Class="mt-4 mb-3" />
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                    @L["Login_DevModeWarning"]
                </MudAlert>
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.BugReport"
                           OnClick="DevLoginAsync" Disabled="_busy">
                    @L["Login_DevSignIn"]
                </MudButton>
            }

        </MudCardContent>
    </MudCard>

    <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary"
             Class="mt-4 d-block">
        No passwords. Your device handles authentication securely.
    </MudText>
</MudContainer>

@code {
    private enum Mode { Login, Register }

    private Mode   _mode = Mode.Login;
    private bool   _busy;
    private bool   _supported;
    private bool   _devModeEnabled;
    private string _displayName = string.Empty;
    private string _deviceName  = string.Empty;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _supported      = await JS.InvokeAsync<bool>("homeGuardAuth.isSupported");
        _devModeEnabled = await AuthApi.IsDevModeEnabledAsync();
        StateHasChanged();
    }

    // ── Login ─────────────────────────────────────────────────────────────────

    private async Task LoginAsync()
    {
        _busy  = true;
        _error = null;

        try
        {
            // Step 1: get challenge from server.
            var optionsJson = await AuthApi.GetLoginOptionsJsonAsync();
            if (optionsJson is null)
            {
                _error = L["Login_ServerUnreachable"];
                return;
            }

            // Step 2: let the browser handle biometric / passkey.
            var assertionElement = await JS.InvokeAsync<System.Text.Json.JsonElement>(
                "homeGuardAuth.authenticate", optionsJson);

            if (assertionElement.TryGetProperty("error", out var err))
            {
                _error = WebAuthnErrorMessage(assertionElement, err);
                return;
            }

            var assertionJson = assertionElement.GetRawText();

            // Step 3: send to server, receive session cookie.
            var result = await AuthApi.CompleteLoginAsync(assertionJson);

            if (!result.Success)
            {
                _error = result.Error ?? L["Login_AuthFailed"];
                return;
            }

            // SessionService is a singleton that caches the first answer it gets. Without
            // dropping it here, the layout's auth gate would still be holding the "nobody
            // is signed in" from a moment ago and bounce straight back to /login.
            Session.Invalidate();

            Snackbar.Add($"Welcome back, {result.DisplayName}!", Severity.Success);
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Dev bypass ────────────────────────────────────────────────────────────
    // Only ever rendered when the server says Auth:DevBypassEnabled is set AND it is
    // running in Development — see AuthEndpoints.MapAuthEndpoints. The route this calls
    // does not exist at all outside Development, regardless of config.

    private async Task DevLoginAsync()
    {
        _busy  = true;
        _error = null;

        try
        {
            var result = await AuthApi.DevLoginAsync();
            if (!result.Success)
            {
                _error = result.Error ?? L["Login_AuthFailed"];
                return;
            }

            Session.Invalidate();   // same reason as in LoginAsync above
            Snackbar.Add($"Dev sign-in: {result.DisplayName}", Severity.Warning);
            Nav.NavigateTo("/");
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Register ──────────────────────────────────────────────────────────────

    private async Task RegisterAsync()
    {
        if (string.IsNullOrWhiteSpace(_displayName)) return;

        _busy  = true;
        _error = null;

        var deviceName = string.IsNullOrWhiteSpace(_deviceName)
            ? L["Login_DefaultDeviceName"]
            : _deviceName.Trim();

        try
        {
            // Step 1: get registration options from server.
            var optionsJson = await AuthApi.GetRegisterOptionsJsonAsync(
                _displayName.Trim(), deviceName);

            if (optionsJson is null)
            {
                _error = L["Login_ServerUnreachable"];
                return;
            }

            // Step 2: browser creates a new passkey.
            var attestationElement = await JS.InvokeAsync<System.Text.Json.JsonElement>(
                "homeGuardAuth.register", optionsJson);

            if (attestationElement.TryGetProperty("error", out var err))
            {
                _error = WebAuthnErrorMessage(attestationElement, err);
                return;
            }

            var attestationJson = attestationElement.GetRawText();

            // Step 3: send to server, receive session cookie.
            var result = await AuthApi.CompleteRegisterAsync(attestationJson);

            if (!result.Success)
            {
                _error = result.Error ?? L["Settings_RegisterFailed"];
                return;
            }

            Session.Invalidate();   // same reason as in LoginAsync above

            Snackbar.Add($"Welcome, {result.DisplayName}! Passkey registered.", Severity.Success);
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // ── WebAuthn error mapping ───────────────────────────────────────────────

    /// <summary>
    /// homeguard-auth.js returns the browser's DOMException name in "error" (stable
    /// across browsers) and its free-text message in "detail" (varies by vendor, often
    /// as unhelpful as "The operation is not supported."). This turns the name into
    /// something the household can act on; the raw detail still goes to the console for
    /// whoever ends up diagnosing it.
    /// </summary>
    private string WebAuthnErrorMessage(System.Text.Json.JsonElement result, System.Text.Json.JsonElement errorName)
    {
        var name   = errorName.GetString();
        var detail = result.TryGetProperty("detail", out var d) ? d.GetString() : null;

        Logger.LogWarning("WebAuthn ceremony failed: {Name} — {Detail}", name, detail);

        return name switch
        {
            "NotSupportedError"  => L["Login_ErrorNotSupported"],
            "NotAllowedError"    => L["Login_ErrorNotAllowed"],
            "SecurityError"      => L["Login_ErrorSecurity"],
            "InvalidStateError"  => L["Login_ErrorInvalidState"],
            "AbortError"         => L["Login_ErrorAbort"],
            _                    => detail ?? name ?? L["Login_AuthFailed"],
        };
    }
}
