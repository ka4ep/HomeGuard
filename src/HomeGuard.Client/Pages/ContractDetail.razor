@page "/contracts/{Id:guid}"
@using System.Globalization
@inject ContractApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IStringLocalizer<Strings> L

@*
    Sequence from the shape brief: who this is → what is next → why → history → actions.
    The schedule is the spine, so it sits directly under the summary rather than at the
    bottom of a pile of fields.
*@

<PageTitle>@(_detail?.Contract.Name ?? L["Nav_Contracts"])</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Warning">@L["Contract_NotFound"]</MudAlert>
}
else
{
    var c = _detail.Contract;

    @* ── Кто это ─────────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Nav.NavigateTo("/contracts"))" />
        <MudStack Spacing="0" Style="min-width:0">
            <MudText Typo="Typo.h5" Style="overflow-wrap:anywhere">@c.Name</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @KindLabel(c.Kind)
                @if (c.Provider is not null)
                {
                    <span> · @c.Provider</span>
                }
                @if (c.ContractNumber is not null)
                {
                    <span> · @c.ContractNumber</span>
                }
            </MudText>
        </MudStack>
        <MudSpacer />
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
            @StatusLabel(c.Status)
        </MudChip>
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true">
            <MudMenuItem OnClick="@(() => _contractDialog.OpenEdit(_detail!))">
                @L["Common_Edit"]
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => _openingDialog.Open(_detail!.Opening))">
                @L["Opening_Title"]
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => _revisionDialog.Open())">
                @L["Revision_Title"]
            </MudMenuItem>
        </MudMenu>
    </MudStack>

    @* ── Что дальше ──────────────────────────────────────────────────────── *@
    @if (_summary is not null)
    {
        <MudGrid Class="mb-4">
            <MudItem xs="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Contract_NextPayment"]</MudText>
                <MudText Typo="Typo.h6" Class="hg-tabular" Style="color:var(--hg-money)">
                    @(_summary.NextDueAmount is { } amount ? Money(amount) : "—")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="hg-tabular">
                    @(_summary.NextDueDate is { } due ? ShortDate(due) : string.Empty)
                </MudText>
            </MudItem>

            <MudItem xs="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Contract_PaidSoFar"]</MudText>
                <MudText Typo="Typo.h6" Class="hg-tabular">@Money(_summary.PaidToDate)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(_summary.InstallmentsTotal is { } total
                        ? L["Contract_Installments", _summary.InstallmentsPaid, total]
                        : _summary.InstallmentsPaid.ToString(CultureInfo.CurrentCulture))
                </MudText>
                @if (IsLoanLike(c.Kind) && _summary.InterestPaidToDate > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                        @L["Contract_InterestPaid", Money(_summary.InterestPaidToDate)]
                    </MudText>
                }
            </MudItem>

            <MudItem xs="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Contract_Balance"]</MudText>
                <MudText Typo="Typo.h6" Class="hg-tabular">
                    @(_summary.RemainingBalance is { } balance ? Money(balance) : "—")
                </MudText>
                @if (IsLoanLike(c.Kind) && _summary.EstimateGap != LoanEstimateGap.None)
                {
                    <MudText Typo="Typo.caption" Class="d-block" Style="color:var(--hg-today); cursor:pointer"
                             @onclick="@(() => _revisionDialog.Open())">
                        @(_summary.EstimateGap == LoanEstimateGap.MissingBalance
                            ? L["Contract_GapMissingBalance"]
                            : L["Contract_GapMissingRate"])
                    </MudText>
                }
            </MudItem>

            <MudItem xs="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Contract_Period"]</MudText>
                <MudText Typo="Typo.body1" Class="hg-tabular">@PeriodLabel(c)</MudText>
                @if (c.CancellationDeadline is { } deadline)
                {
                    <MudText Typo="Typo.caption" Style="color:var(--hg-today)">
                        @L["Contract_CancelBy", ShortDate(deadline)]
                    </MudText>
                }
                else if (IsLoanLike(c.Kind) && _summary.PayoffDate is { } payoff)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @L["Contract_PayoffBy", ShortDate(payoff)]
                    </MudText>
                }
            </MudItem>
        </MudGrid>

        @if (_summary.OverdueCount > 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                @L["Contract_OverdueCount", _summary.OverdueCount]
            </MudAlert>
        }
    }

    @* ── Почему ──────────────────────────────────────────────────────────── *@
    <MarkdownCard Markdown="@_detail.SummaryMarkdown"
                  Title="@SummaryTitle"
                  Icon="@Icons.Material.Outlined.Article"
                  ShowEmpty="true" />

    @if (c.Kind == ContractKind.Insurance
         && (_detail.CoverageAmount is not null || _detail.Deductible is not null))
    {
        <MudStack Row="true" Spacing="4" Class="mb-4" Style="flex-wrap:wrap">
            @if (_detail.CoverageAmount is { } coverage)
            {
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Contract_Coverage"]</MudText>
                    <MudText Typo="Typo.body1" Class="hg-tabular">@Money(coverage)</MudText>
                </MudStack>
            }
            @if (_detail.Deductible is { } deductible)
            {
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Contract_Deductible"]</MudText>
                    <MudText Typo="Typo.body1" Class="hg-tabular">@Money(deductible)</MudText>
                </MudStack>
            }
        </MudStack>
    }

    @* ── График ──────────────────────────────────────────────────────────── *@
    <MudCard Elevation="1" Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" Class="mr-1" />
                    @L["Schedule_Title"]
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (_detail.Opening is { } opening)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                    @L["Contract_OpeningNote",
                       opening.InstallmentsPaid, Money(opening.AmountPaid), ShortDate(opening.AsOfDate)]
                </MudText>
            }
            <PaymentSchedule Entries="_schedule"
                             Currency="@c.Currency"
                             OnConfirmPayment="ConfirmPaymentAsync"
                             OnEditPayment="EditPaymentAsync" />
        </MudCardContent>
    </MudCard>

    @* ── История плана ───────────────────────────────────────────────────── *@
    @if (_detail.Revisions.Count > 1)
    {
        <MudCard Elevation="1" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@L["Contract_Revisions"]</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @foreach (var r in _detail.Revisions.OrderByDescending(r => r.Version))
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"
                              Class="py-1">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2">@ReasonLabel(r.Reason)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="hg-tabular">
                                @L["Contract_FromDate", ShortDate(r.EffectiveFrom)]
                            </MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Class="hg-tabular">
                            @Money(r.EffectiveInstallment)
                        </MudText>
                    </MudStack>
                    @foreach (var a in r.Adjustments)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-4 d-block">
                            @a.Name — @Money(a.Amount)
                        </MudText>
                    }
                    <MudDivider Class="my-1" />
                }
            </MudCardContent>
        </MudCard>
    }

    @if (!string.IsNullOrWhiteSpace(_detail.Notes))
    {
        <MarkdownCard Markdown="@_detail.Notes" Title="@NotesTitle" />
    }

    <ContractDialog @ref="_contractDialog" OnSaved="OnDialogSavedAsync" />
    <PaymentDialog @ref="_paymentDialog" OnSaved="LoadAsync" />
    <OpeningPositionDialog @ref="_openingDialog" ContractId="Id" OnSaved="LoadAsync" />
    <RevisionDialog @ref="_revisionDialog"
                    ContractId="Id"
                    Kind="c.Kind"
                    Currency="@c.Currency"
                    Current="@_detail.Revisions.OrderByDescending(r => r.Version).FirstOrDefault()"
                    InstallmentsPaid="@(_summary?.InstallmentsPaid ?? 0)"
                    OnSaved="LoadAsync" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ContractDetailDto? _detail;
    private ContractSummaryDto? _summary;
    private List<ScheduleEntryDto> _schedule = [];
    private bool _loading = true;

    private ContractDialog _contractDialog = null!;
    private OpeningPositionDialog _openingDialog = null!;
    private RevisionDialog _revisionDialog = null!;
    private PaymentDialog _paymentDialog = null!;

    private string SummaryTitle => L["Contract_Summary"];
    private string NotesTitle   => L["Form_Notes"];

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        var detailTask   = Api.GetAsync(Id);
        var summaryTask  = Api.GetSummaryAsync(Id);
        var scheduleTask = Api.GetScheduleAsync(Id);
        await Task.WhenAll(detailTask, summaryTask, scheduleTask);

        _detail   = detailTask.Result;
        _summary  = summaryTask.Result;
        _schedule = scheduleTask.Result ?? [];
        _loading  = false;
    }

    /// <summary>
    /// "Two taps from the notification": the amount and the date are already known, so
    /// confirming does not open a dialog. Correcting an amount is the rarer case and
    /// belongs in the payment editor.
    /// </summary>
    private async Task ConfirmPaymentAsync(ScheduleEntryDto entry)
    {
        if (entry.PaymentId is not { } paymentId) return;

        var today  = DateOnly.FromDateTime(DateTime.Now);
        var result = await Api.ConfirmPaymentAsync(paymentId, new ConfirmPaymentDto(today));

        if (result is null)
        {
            Snackbar.Add(L["Schedule_ConfirmFailed"], Severity.Error);
            return;
        }

        Snackbar.Add(L["Schedule_Confirmed"], Severity.Success);
        await LoadAsync();
    }

    private Task OnDialogSavedAsync(ContractDto? _) => LoadAsync();

    private Task EditPaymentAsync(ScheduleEntryDto entry)
    {
        var payment = _detail?.Payments.FirstOrDefault(p => p.Id == entry.PaymentId);
        if (payment is not null) _paymentDialog.Open(payment);
        return Task.CompletedTask;
    }

    // ── Labels ───────────────────────────────────────────────────────────────

    private static bool IsLoanLike(ContractKind kind) => kind is ContractKind.Loan or ContractKind.Lease;

    private string KindLabel(ContractKind kind)     => L["ContractKind_" + kind];
    private string StatusLabel(ContractStatus s)    => L["ContractStatus_" + s];
    private string ReasonLabel(RevisionReason r)    => L["RevisionReason_" + r];

    private string PeriodLabel(ContractDto c)
        => c.EndDate is { } end
            ? $"{ShortDate(c.StartDate)} → {ShortDate(end)}"
            : $"{ShortDate(c.StartDate)} → {L["Contract_OpenEnded"]}";

    private static string ShortDate(DateOnly date)
        => date.ToString("d", CultureInfo.CurrentCulture);

    private string Money(decimal amount)
    {
        var currency = _detail?.Contract.Currency ?? "EUR";
        return $"{amount.ToString("N2", CultureInfo.CurrentCulture)} {CurrencySymbol(currency)}";
    }

    private static string CurrencySymbol(string currency) => currency switch
    {
        "EUR" => "€",
        "USD" => "$",
        "CZK" => "Kč",
        "GBP" => "£",
        _     => currency,
    };
}
