@page "/contracts/{Id:guid}"
@using System.Globalization
@using HomeGuard.Client.Model
@inject ContractApiClient Api
@inject BlobApiClient Blobs
@inject OutboxSyncService Outbox
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject IStringLocalizer<Strings> L
@implements IDisposable

@*
    Sequence from the shape brief: who this is → what is next → why → history → actions.
    The schedule is the spine, so it sits directly under the summary rather than at the
    bottom of a pile of fields.
*@

<PageTitle>@(_detail?.Contract.Name ?? L["Nav_Contracts"])</PageTitle>

@*
    Second Object Rule (DESIGN.md): extra width buys a second object, not wider rows.
    At >=900px the rail sits beside the open contract so switching contracts does not
    cost the list; on phone the rail is hidden and this is exactly the page it was before.
*@
<div class="hg-contract-workspace">
    <div class="hg-contract-rail">
        @if (_rail is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            @foreach (var item in _rail)
            {
                <button type="button"
                        class="hg-contract-rail-item @(item.Id == Id ? "is-active" : "")"
                        @onclick="() => OpenRailItem(item.Id)">
                    <span class="hg-status-dot" style="@RailStatusDotStyle(item)"></span>
                    <span class="hg-contract-rail-item-text">
                        <span class="hg-contract-rail-item-name" title="@item.Name">@item.Name</span>
                        <span class="hg-contract-rail-item-sub hg-tabular">@RailSubLabel(item)</span>
                    </span>
                </button>
            }
        }
    </div>

    <div class="hg-contract-pane">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_detail is null)
    {
        <MudAlert Severity="Severity.Warning">@L["Contract_NotFound"]</MudAlert>
    }
    else
    {
    var c = _detail.Contract;

    @* ── Кто это ─────────────────────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       aria-label="@L["Common_Back"]"
                       OnClick="@(() => Nav.NavigateTo("/contracts"))" />
        <MudStack Spacing="0" Style="min-width:0">
            <MudText Typo="Typo.h5" Style="overflow-wrap:anywhere">@c.Name</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @KindLabel(c.Kind)
                @if (c.Provider is not null)
                {
                    <span> · @c.Provider</span>
                }
                @if (c.ContractNumber is not null)
                {
                    <span> · @c.ContractNumber</span>
                }
            </MudText>
        </MudStack>
        <MudSpacer />
        <ContractStatusChip Status="c.Status" />
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true">
            <MudMenuItem OnClick="@(() => _contractDialog.OpenEdit(_detail!))">
                @L["Common_Edit"]
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => _statusDialog.Open(Id, c.Status, _detail!.StatusReason))">
                @L["Contract_ChangeStatusTitle"]
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => _openingDialog.Open(_detail!.Opening))">
                @L["Opening_Title"]
            </MudMenuItem>
            <MudMenuItem OnClick="@(() => _revisionDialog.Open())">
                @L["Revision_Title"]
            </MudMenuItem>
        </MudMenu>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_detail.StatusReason))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @_detail.StatusReason
        </MudText>
    }

    @* ── Что дальше ──────────────────────────────────────────────────────── *@
    @if (_summary is not null)
    {
        <MudGrid Class="mb-4">
            <MudItem xs="6" md="3">
                <FieldWell Label="@L["Contract_NextPayment"]">
                    <span class="hg-field-well-value hg-tabular" style="color:var(--hg-money)">
                        @(_summary.NextDueAmount is { } amount ? Money(amount) : "—")
                    </span>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="hg-tabular">
                        @(_summary.NextDueDate is { } due ? ShortDate(due) : string.Empty)
                    </MudText>
                </FieldWell>
            </MudItem>

            <MudItem xs="6" md="3">
                <FieldWell Label="@L["Contract_PaidSoFar"]">
                    <span class="hg-field-well-value hg-tabular">@Money(_summary.PaidToDate)</span>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(_summary.InstallmentsTotal is { } total
                            ? L["Contract_Installments", _summary.InstallmentsPaid, total]
                            : _summary.InstallmentsPaid.ToString(CultureInfo.CurrentCulture))
                    </MudText>
                    @if (IsLoanLike(c.Kind) && _summary.InterestPaidToDate > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                            @L["Contract_InterestPaid", Money(_summary.InterestPaidToDate)]
                        </MudText>
                    }
                </FieldWell>
            </MudItem>

            <MudItem xs="6" md="3">
                <FieldWell Label="@L["Contract_Balance"]">
                    <span class="hg-field-well-value hg-tabular">
                        @(_summary.RemainingBalance is { } balance ? Money(balance) : "—")
                    </span>
                    @if (IsLoanLike(c.Kind) && _summary.EstimateGap != LoanEstimateGap.None)
                    {
                        <MudText Typo="Typo.caption" Class="d-block" Style="color:var(--hg-today-text); cursor:pointer"
                                 @onclick="@(() => _revisionDialog.Open())">
                            @(_summary.EstimateGap == LoanEstimateGap.MissingBalance
                                ? L["Contract_GapMissingBalance"]
                                : L["Contract_GapMissingRate"])
                        </MudText>
                    }
                </FieldWell>
            </MudItem>

            <MudItem xs="6" md="3">
                <FieldWell Label="@L["Contract_Period"]">
                    <span class="hg-field-well-value hg-tabular">@PeriodLabel(c)</span>
                    @if (c.CancellationDeadline is { } deadline)
                    {
                        <MudText Typo="Typo.caption" Style="color:var(--hg-today-text)">
                            @L["Contract_CancelBy", ShortDate(deadline)]
                        </MudText>
                    }
                    else if (IsLoanLike(c.Kind) && _summary.PayoffDate is { } payoff)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["Contract_PayoffBy", ShortDate(payoff)]
                        </MudText>
                    }
                </FieldWell>
            </MudItem>
        </MudGrid>

        @if (_summary.OverdueCount > 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                @L["Contract_OverdueCount", _summary.OverdueCount]
            </MudAlert>
        }
    }

    @* ── Почему ──────────────────────────────────────────────────────────── *@
    <MarkdownCard Markdown="@_detail.SummaryMarkdown"
                  Title="@SummaryTitle"
                  Icon="@Icons.Material.Outlined.Article"
                  ShowEmpty="true" />

    @* ── Документы ───────────────────────────────────────────────────────── *@
    <MudCard Elevation="1" Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Outlined.AttachFile" Class="mr-1" />
                    @L["Contract_Attachments"]
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudIconButton Icon="@(_showCapture ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)"
                               aria-label="@(_showCapture ? L["Common_Close"] : L["Contract_AddAttachment"])"
                               OnClick="@(() => _showCapture = !_showCapture)" />
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            @if (_detail.Attachments.Count == 0 && _pendingAttachments.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Contract_AttachmentsEmpty"]</MudText>
            }
            else
            {
                @foreach (var a in _detail.Attachments)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="py-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="min-width:0">
                            <MudIcon Icon="@AttachmentIcon(a.ContentType)" Size="Size.Small" Color="Color.Secondary" />
                            <MudLink Href="@Blobs.GetDownloadUrl(a.Id)" Target="_blank" Style="overflow-wrap:anywhere">
                                @a.FileName
                            </MudLink>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="hg-tabular">
                                @FormatSize(a.SizeBytes)
                            </MudText>
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                       Size="Size.Small" Class="hg-touch-target-sm"
                                       aria-label="@L["Common_Delete"]"
                                       OnClick="@(() => DeleteAttachmentAsync(a))" />
                    </MudStack>
                }
                @foreach (var p in _pendingAttachments)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="py-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="min-width:0">
                            <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2" Style="overflow-wrap:anywhere">@p.FileName</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                @L["Contract_AttachmentQueued"]
                            </MudChip>
                        </MudStack>
                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                       Size="Size.Small" Class="hg-touch-target-sm"
                                       aria-label="@L["Common_Delete"]"
                                       OnClick="@(() => RemovePendingAttachmentAsync(p))" />
                    </MudStack>
                }
            }

            <MudCollapse Expanded="_showCapture">
                <div class="mt-2">
                    <DocumentCapture OnCapture="OnDocumentCapturedAsync" Label="@L["Contract_AddAttachment"]" />
                    @if (_uploading)
                    {
                        <MudProgressLinear Indeterminate="true" Class="mt-2" />
                    }
                </div>
            </MudCollapse>
        </MudCardContent>
    </MudCard>

    @if (c.Kind == ContractKind.Insurance
         && (_detail.CoverageAmount is not null || _detail.Deductible is not null))
    {
        <MudStack Row="true" Spacing="4" Class="mb-4" Style="flex-wrap:wrap">
            @if (_detail.CoverageAmount is { } coverage)
            {
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Contract_Coverage"]</MudText>
                    <MudText Typo="Typo.body1" Class="hg-tabular">@Money(coverage)</MudText>
                </MudStack>
            }
            @if (_detail.Deductible is { } deductible)
            {
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Contract_Deductible"]</MudText>
                    <MudText Typo="Typo.body1" Class="hg-tabular">@Money(deductible)</MudText>
                </MudStack>
            }
        </MudStack>
    }

    @* ── График ──────────────────────────────────────────────────────────── *@
    <MudCard Elevation="1" Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" Class="mr-1" />
                    @L["Schedule_Title"]
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (_detail.Opening is { } opening)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                    @L["Contract_OpeningNote",
                       opening.InstallmentsPaid, Money(opening.AmountPaid), ShortDate(opening.AsOfDate)]
                </MudText>
            }
            <PaymentSchedule Entries="_schedule"
                             Currency="@c.Currency"
                             OnConfirmPayment="ConfirmPaymentAsync"
                             OnEditPayment="EditPaymentAsync" />
        </MudCardContent>
    </MudCard>

    @* ── История плана ───────────────────────────────────────────────────── *@
    @if (_detail.Revisions.Count > 1)
    {
        <MudCard Elevation="1" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@L["Contract_Revisions"]</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @foreach (var r in _detail.Revisions.OrderByDescending(r => r.Version))
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"
                              Class="py-1">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2">@ReasonLabel(r.Reason)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="hg-tabular">
                                @L["Contract_FromDate", ShortDate(r.EffectiveFrom)]
                            </MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Class="hg-tabular">
                            @Money(r.EffectiveInstallment)
                        </MudText>
                    </MudStack>
                    @foreach (var a in r.Adjustments)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-4 d-block">
                            @a.Name — @Money(a.Amount)
                        </MudText>
                    }
                    <MudDivider Class="my-1" />
                }
            </MudCardContent>
        </MudCard>
    }

    @if (!string.IsNullOrWhiteSpace(_detail.Notes))
    {
        <MarkdownCard Markdown="@_detail.Notes" Title="@NotesTitle" />
    }

    <ContractDialog @ref="_contractDialog" OnSaved="OnDialogSavedAsync" />
    <ContractStatusDialog @ref="_statusDialog" OnSaved="LoadAsync" />
    <PaymentDialog @ref="_paymentDialog" OnSaved="LoadAsync" />
    <OpeningPositionDialog @ref="_openingDialog" ContractId="Id" OnSaved="LoadAsync" />
    <RevisionDialog @ref="_revisionDialog"
                    ContractId="Id"
                    Kind="c.Kind"
                    Currency="@c.Currency"
                    Current="@_detail.Revisions.OrderByDescending(r => r.Version).FirstOrDefault()"
                    InstallmentsPaid="@(_summary?.InstallmentsPaid ?? 0)"
                    OnSaved="LoadAsync" />
    }
    </div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private ContractDetailDto? _detail;
    private ContractSummaryDto? _summary;
    private List<ScheduleEntryDto> _schedule = [];
    private List<PendingBlobUpload> _pendingAttachments = [];
    private List<ContractDto>? _rail;
    private bool _loading = true;
    private bool _showCapture;
    private bool _uploading;

    private ContractDialog _contractDialog = null!;
    private ContractStatusDialog _statusDialog = null!;
    private OpeningPositionDialog _openingDialog = null!;
    private RevisionDialog _revisionDialog = null!;
    private PaymentDialog _paymentDialog = null!;

    private string SummaryTitle => L["Contract_Summary"];
    private string NotesTitle   => L["Form_Notes"];

    protected override async Task OnInitializedAsync()
    {
        Outbox.OutboxChanged += OnOutboxChanged;
        // Independent of Id: the rail is the same list regardless of which contract is
        // open, so it loads once here rather than on every LoadAsync() (OnParametersSetAsync).
        _rail = await Api.GetAllAsync() ?? [];
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    public void Dispose() => Outbox.OutboxChanged -= OnOutboxChanged;

    private void OnOutboxChanged() => InvokeAsync(async () =>
    {
        _pendingAttachments = [.. await Outbox.GetPendingBlobsForOwnerAsync(Id)];
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _loading = true;

        var detailTask   = Api.GetAsync(Id);
        var summaryTask  = Api.GetSummaryAsync(Id);
        var scheduleTask = Api.GetScheduleAsync(Id);
        var pendingTask  = Outbox.GetPendingBlobsForOwnerAsync(Id);
        await Task.WhenAll(detailTask, summaryTask, scheduleTask, pendingTask);

        _detail   = detailTask.Result;
        _summary  = summaryTask.Result;
        _schedule = scheduleTask.Result ?? [];
        _pendingAttachments = [.. pendingTask.Result];
        _loading  = false;
    }

    // ── Documents ────────────────────────────────────────────────────────────

    /// <summary>
    /// DocumentCapture fires OnCapture the instant a file is picked or a photo is taken —
    /// there is no separate "confirm" step on its side, so the upload starts right here.
    /// Going through the outbox (rather than BlobApiClient directly) means a capture made
    /// with no signal is not lost: it is queued in IndexedDB and FlushAsync sends it the
    /// moment a connection is available, same as everything else offline-first in this app.
    /// </summary>
    private async Task OnDocumentCapturedAsync(CapturedDocument doc)
    {
        _uploading = true;
        StateHasChanged();

        await Outbox.EnqueueBlobUploadAsync(doc.Data, doc.MimeType, doc.FileName, Id, "Contract");
        var result = await Outbox.FlushAsync();

        _uploading   = false;
        _showCapture = false;

        Snackbar.Add(
            result.Committed > 0 ? L["Contract_AttachmentUploaded"] : L["Contract_AttachmentSaved"],
            Severity.Success);

        await LoadAsync();
    }

    private async Task DeleteAttachmentAsync(BlobDto blob)
    {
        var confirmed = await Dialog.ShowMessageBoxAsync(
            title: L["Contract_DeleteAttachmentTitle"],
            message: L["Contract_DeleteAttachmentMessage", blob.FileName],
            yesText: L["Common_Delete"],
            cancelText: L["Common_Cancel"]);

        if (confirmed != true) return;

        if (!await Blobs.DeleteAsync(blob.Id))
        {
            Snackbar.Add(L["Contract_AttachmentDeleteFailed"], Severity.Error);
            return;
        }

        Snackbar.Add(L["Contract_AttachmentDeleted"], Severity.Success);
        await LoadAsync();
    }

    private async Task RemovePendingAttachmentAsync(PendingBlobUpload pending)
    {
        var confirmed = await Dialog.ShowMessageBoxAsync(
            title: L["Contract_DeleteAttachmentTitle"],
            message: L["Contract_DeleteAttachmentMessage", pending.FileName],
            yesText: L["Common_Delete"],
            cancelText: L["Common_Cancel"]);

        if (confirmed != true) return;

        await Outbox.RemovePendingBlobAsync(pending.ClientOperationId);
        _pendingAttachments = [.. await Outbox.GetPendingBlobsForOwnerAsync(Id)];
    }

    private static string AttachmentIcon(string contentType) => contentType switch
    {
        "application/pdf" => Icons.Material.Outlined.PictureAsPdf,
        _ when contentType.StartsWith("image/", StringComparison.Ordinal) => Icons.Material.Outlined.InsertPhoto,
        _ => Icons.Material.Outlined.InsertDriveFile,
    };

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024        => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _             => $"{bytes / 1024.0 / 1024.0:0.#} MB",
    };

    /// <summary>
    /// "Two taps from the notification": the amount and the date are already known, so
    /// confirming does not open a dialog. Correcting an amount is the rarer case and
    /// belongs in the payment editor.
    /// </summary>
    private async Task ConfirmPaymentAsync(ScheduleEntryDto entry)
    {
        if (entry.PaymentId is not { } paymentId) return;

        var today  = DateOnly.FromDateTime(DateTime.Now);
        var result = await Api.ConfirmPaymentAsync(paymentId, new ConfirmPaymentDto(today));

        if (result is null)
        {
            Snackbar.Add(L["Schedule_ConfirmFailed"], Severity.Error);
            return;
        }

        Snackbar.Add(L["Schedule_Confirmed"], Severity.Success);
        await LoadAsync();
    }

    private async Task OnDialogSavedAsync(ContractDto? _)
    {
        await LoadAsync();
        _rail = await Api.GetAllAsync() ?? [];   // e.g. a rename needs to reach the rail too
    }

    private Task EditPaymentAsync(ScheduleEntryDto entry)
    {
        var payment = _detail?.Payments.FirstOrDefault(p => p.Id == entry.PaymentId);
        if (payment is not null) _paymentDialog.Open(payment);
        return Task.CompletedTask;
    }

    // ── Labels ───────────────────────────────────────────────────────────────

    private static bool IsLoanLike(ContractKind kind) => kind is ContractKind.Loan or ContractKind.Lease;

    private string KindLabel(ContractKind kind)     => L["ContractKind_" + kind];
    private string ReasonLabel(RevisionReason r)    => L["RevisionReason_" + r];

    // Same rule Contracts.razor's list view uses — kept in sync there rather than shared,
    // matching how CurrencySymbol/ShortDate are already duplicated per page in this file.
    private static string RailStatusDotStyle(ContractDto c) => c.Status switch
    {
        ContractStatus.Active    => "background:var(--hg-success-text)",
        ContractStatus.Suspended => "background:var(--hg-warning-text)",
        ContractStatus.Cancelled => "background:var(--hg-danger-text)",
        _                        => "background:var(--hg-text-subtle)",
    };

    private string RailSubLabel(ContractDto c) => c.Provider ?? KindLabel(c.Kind);

    private void OpenRailItem(Guid id) => Nav.NavigateTo($"/contracts/{id}");

    private string PeriodLabel(ContractDto c)
        => c.EndDate is { } end
            ? $"{ShortDate(c.StartDate)} → {ShortDate(end)}"
            : $"{ShortDate(c.StartDate)} → {L["Contract_OpenEnded"]}";

    private static string ShortDate(DateOnly date)
        => date.ToString("d", CultureInfo.CurrentCulture);

    private string Money(decimal amount)
    {
        var currency = _detail?.Contract.Currency ?? "EUR";
        return $"{amount.ToString("N2", CultureInfo.CurrentCulture)} {ContractFormat.CurrencySymbol(currency)}";
    }
}
