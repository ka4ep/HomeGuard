@page "/timeline"
@using System.Text.RegularExpressions
@inject EquipmentApiClient EquipmentApi
@inject WarrantyApiClient WarrantyApi
@inject ServiceRecordApiClient ServiceApi
@inject RecurringRuleApiClient RuleApi
@inject MeterReadingApiClient MeterApi
@inject TimelineInterop TimelineInterop
@inject ISnackbar Snackbar
@inject IStringLocalizer<Strings> L
@implements IAsyncDisposable

<PageTitle>@L["Nav_Timeline"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">@L["Nav_Timeline"]</MudText>

<MudStack Row="true" Class="mb-4" Spacing="2">
    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               OnClick="@(() => TimelineInterop.FocusTodayAsync())">@L["Timeline_Today"]</MudButton>
    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               OnClick="@(() => TimelineInterop.FitAsync())">@L["Timeline_FitAll"]</MudButton>
    <MudSpacer />
    <MudChip T="string" Style="@WarrantyChipStyle" Size="Size.Small"
             Icon="@Icons.Material.Filled.VerifiedUser"
             OnClick="ToggleWarrantiesAsync">@L["Nav_Warranties"]</MudChip>
    <MudChip T="string" Style="@ServiceChipStyle" Size="Size.Small"
             Icon="@Icons.Material.Filled.Build"
             OnClick="ToggleServicesAsync">@L["Nav_Service"]</MudChip>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-2" />
}

<div id="@ElementId" class="hg-timeline-host"></div>

@code {
    private bool _loading = true;
    private bool _showWarranties = true;
    private bool _showServices = true;
    private const string ElementId = "hg-timeline";
    private const string WarrantyColor = "#7F77DD";
    private const string ServiceColor = "#1D9E75";

    private List<WarrantyDto> _warranties = [];
    private List<ServiceRecordDto> _services = [];
    private List<RecurringRuleWithPredictionsDto> _rules = [];
    private Dictionary<Guid, string> _equipMap = [];
    private Dictionary<Guid, string?> _equipMeterUnit = [];
    private Dictionary<Guid, List<MeterReadingDto>> _readings = [];

    // Canonical title per service record ID (computed once after load)
    private Dictionary<Guid, string> _canonicals = [];

    // ── Chip styles ───────────────────────────────────────────────────────────

    private string WarrantyChipStyle => _showWarranties
        ? $"background:{WarrantyColor};color:white;cursor:pointer"
        : $"background:transparent;color:{WarrantyColor};border:1px solid {WarrantyColor};cursor:pointer";

    private string ServiceChipStyle => _showServices
        ? $"background:{ServiceColor};color:white;cursor:pointer"
        : $"background:transparent;color:{ServiceColor};border:1px solid {ServiceColor};cursor:pointer";

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        TimelineInterop.MaterializeRequested += OnMaterializeRequestedAsync;

        await LoadDataAsync();
        await TimelineInterop.CreateAsync(ElementId, BuildRows(), BuildTimelineOptions());

        _loading = false;
        StateHasChanged();
    }

    private async Task LoadDataAsync()
    {
        var equipTask = EquipmentApi.GetAllAsync();
        var warrantyTask = WarrantyApi.GetActiveAsync();
        var serviceTask = ServiceApi.GetAllAsync();
        var rulesTask = RuleApi.GetAllWithPredictionsAsync();
        await Task.WhenAll(equipTask, warrantyTask, serviceTask, rulesTask);

        var equipment = equipTask.Result ?? [];
        _equipMap = equipment.ToDictionary(e => e.Id, e => e.Name);
        _equipMeterUnit = equipment.ToDictionary(e => e.Id, e => e.MeterUnit);
        _warranties = warrantyTask.Result ?? [];
        _services = serviceTask.Result ?? [];
        _rules = rulesTask.Result ?? [];

        // Standalone meter readings — only equipment with a meter has any
        var metered = equipment.Where(e => !string.IsNullOrEmpty(e.MeterUnit)).Select(e => e.Id).ToList();
        var readingTasks = metered.ToDictionary(id => id, id => MeterApi.GetByEquipmentAsync(id));
        await Task.WhenAll(readingTasks.Values);
        _readings = readingTasks.ToDictionary(
            kv => kv.Key,
            kv => (kv.Value.Result ?? []).Where(r => r.Source != "Service").ToList());

        // Build canonical title clusters per equipment (fuzzy-matched, stable order)
        var clustersByEquip = new Dictionary<Guid, List<string>>();
        foreach (var sr in _services.OrderBy(s => s.ServiceDate))
        {
            if (!clustersByEquip.TryGetValue(sr.EquipmentId, out var clusters))
                clustersByEquip[sr.EquipmentId] = clusters = [];
            _canonicals[sr.Id] = FuzzyGetOrAdd(clusters, sr.Title);
        }
    }

    // ── Toggle handlers ───────────────────────────────────────────────────────

    private async Task ToggleWarrantiesAsync()
    {
        _showWarranties = !_showWarranties;
        await TimelineInterop.UpdateAsync(BuildRows());
    }

    private async Task ToggleServicesAsync()
    {
        _showServices = !_showServices;
        await TimelineInterop.UpdateAsync(BuildRows());
    }

    // ── Build timeline rows ──────────────────────────────────────────────────

    private List<TimelineRow> BuildRows()
    {
        var rows = new List<TimelineRow>();

        // ── Warranties — one row per warranty, group label on the first row per equipment ──
        if (_showWarranties)
        {
            Guid? lastEquip = null;
            foreach (var w in _warranties.OrderBy(w => _equipMap.GetValueOrDefault(w.EquipmentId, "")).ThenBy(w => w.EndDate))
            {
                var equipName = _equipMap.GetValueOrDefault(w.EquipmentId, "");
                var groupLabel = w.EquipmentId == lastEquip ? null : equipName;
                lastEquip = w.EquipmentId;

                rows.Add(new TimelineRow(
                    Id: $"w-{w.Id}",
                    Label: w.Name,
                    Group: groupLabel,
                    Color: WarrantyColor,
                    Events:
                    [
                        new TimelineEvent(
                            Id: $"{w.Id}-start", DateIso: w.StartDate.ToString("yyyy-MM-dd", null),
                            Title: w.Name, EquipmentName: equipName, EquipmentId: w.EquipmentId, IsStart: true),
                        new TimelineEvent(
                            Id: $"{w.Id}-end", DateIso: w.EndDate.ToString("yyyy-MM-dd", null),
                            Title: w.Name, EquipmentName: equipName, EquipmentId: w.EquipmentId, IsExpiry: true),
                    ]
                ));
            }
        }

        // ── Service records — one row per (equipment, canonical title) cluster ─────
        if (_showServices)
        {
            var byEquip = _services
                .GroupBy(s => s.EquipmentId)
                .OrderBy(g => _equipMap.GetValueOrDefault(g.Key, ""));

            foreach (var grp in byEquip)
            {
                var equipName = _equipMap.GetValueOrDefault(grp.Key, grp.Key.ToString());
                var meterUnit = _equipMeterUnit.GetValueOrDefault(grp.Key);
                var sorted = grp.OrderBy(s => s.ServiceDate).ToList();

                var canonicalsForEquip = sorted
                    .Select(s => _canonicals.GetValueOrDefault(s.Id, s.Title))
                    .Distinct()
                    .ToList();

                var firstCanonical = canonicalsForEquip.FirstOrDefault();

                foreach (var canonical in canonicalsForEquip)
                {
                    var events = sorted
                        .Where(s => _canonicals.GetValueOrDefault(s.Id, s.Title) == canonical)
                        .Select(s => new TimelineEvent(
                            Id: $"s-{s.Id}",
                            DateIso: s.ServiceDate.ToString("yyyy-MM-dd", null),
                            Title: s.Title,
                            EquipmentName: equipName,
                            EquipmentId: grp.Key,
                            MeterReading: s.MeterReading,
                            MeterUnit: meterUnit,
                            Cost: s.Cost,
                            ServiceProvider: s.ServiceProvider,
                            Notes: s.Notes,
                            Status: s.Status,
                            RecordId: s.Id))
                        .ToList();

                    // Predicted (dashed) points — computed ahead, not stored records.
                    var rule = _rules.FirstOrDefault(x =>
                        x.Rule.EquipmentId == grp.Key &&
                        string.Equals(x.Rule.Title.Trim(), canonical.Trim(), StringComparison.OrdinalIgnoreCase));
                    if (rule is not null)
                    {
                        events.AddRange(rule.Predictions.Select(p => new TimelineEvent(
                            Id: $"pred-{rule.Rule.Id}-{p.Date:yyyyMMdd}",
                            DateIso: p.Date.ToString("yyyy-MM-dd", null),
                            Title: canonical,
                            EquipmentName: equipName,
                            EquipmentId: grp.Key,
                            MeterReading: p.MeterReading,
                            MeterUnit: meterUnit,
                            IsPredicted: true,
                            RuleId: rule.Rule.Id)));
                    }

                    // Standalone readings — ticks on the first row of the equipment's cluster only
                    List<TimelineMark>? marks = null;
                    if (canonical == firstCanonical && _readings.TryGetValue(grp.Key, out var rds) && rds.Count > 0)
                        marks = rds
                            .OrderBy(r => r.ReadingDate)
                            .Select(r => new TimelineMark(
                                DateIso: r.ReadingDate.ToString("yyyy-MM-dd", null),
                                Value: r.Value,
                                Unit: meterUnit,
                                Source: r.Source,
                                Note: r.Note))
                            .ToList();

                    rows.Add(new TimelineRow(
                        Id: $"equip-{grp.Key}-{Math.Abs(canonical.GetHashCode()):x8}",
                        Label: canonical,
                        Group: canonical == firstCanonical ? equipName : null,
                        Color: ServiceColor,
                        Events: events,
                        Marks: marks
                    ));
                }
            }
        }

        return rows;
    }

    // ── Fuzzy title clustering (Levenshtein, threshold 25%) ──────────────────

    private static string FuzzyGetOrAdd(List<string> clusters, string title)
    {
        var norm = Norm(title);
        foreach (var c in clusters)
        {
            var normC = Norm(c);
            var maxLen = Math.Max(norm.Length, normC.Length);
            if (maxLen == 0 || (double)Lev(norm, normC) / maxLen < 0.25)
                return c;                       // matched → return first-seen canonical
        }
        clusters.Add(title);                    // new cluster
        return title;
    }

    private static string Norm(string s) =>
        Regex.Replace(s.Trim().ToLowerInvariant(), @"\s+", " ");

    private static int Lev(string a, string b)
    {
        int m = a.Length, n = b.Length;
        var d = new int[m + 1, n + 1];
        for (int i = 0; i <= m; i++) d[i, 0] = i;
        for (int j = 0; j <= n; j++) d[0, j] = j;
        for (int i = 1; i <= m; i++)
            for (int j = 1; j <= n; j++)
                d[i, j] = a[i - 1] == b[j - 1]
                    ? d[i - 1, j - 1]
                    : 1 + Math.Min(Math.Min(d[i - 1, j], d[i, j - 1]), d[i - 1, j - 1]);
        return d[m, n];
    }

    /// <summary>
    /// The timeline card is drawn by JavaScript, so its labels have to be handed over
    /// rather than looked up there — the resources live on this side.
    /// </summary>
    private TimelineOptions BuildTimelineOptions() => new(
        Locale: System.Globalization.CultureInfo.CurrentCulture.Name,
        Labels: new Dictionary<string, string>
        {
            ["date"]            = L["Meter_Date"],
            ["status"]          = L["Service_Status"],
            ["predicted"]       = L["Timeline_Predicted"],
            ["meterReading"]    = L["Service_Meter"],
            ["cost"]            = L["Service_Cost"],
            ["provider"]        = L["Service_Provider"],
            ["event"]           = L["Timeline_Event"],
            ["warrantyStart"]   = L["Timeline_WarrantyStart"],
            ["warrantyExpiry"]  = L["Timeline_WarrantyExpiry"],
            ["notes"]           = L["Form_Notes"],
            ["materializeNow"]  = L["Timeline_MaterializeNow"],
            ["openRule"]        = L["Timeline_OpenRule"],
            ["editRecord"]      = L["Timeline_EditRecord"],
        },
        Statuses: new Dictionary<string, string>
        {
            ["Completed"] = L["ServiceStatus_Completed"],
            ["Planned"]   = L["ServiceStatus_Planned"],
        });

    // ── Materialize ("Materialize now" on a Predicted event's card) ───────────

    private async Task OnMaterializeRequestedAsync(Guid ruleId)
    {
        var result = await RuleApi.MaterializeNowAsync(ruleId);
        if (result is null)
        {
            Snackbar.Add(L["Timeline_CannotMaterialize"], Severity.Warning);
            return;
        }

        Snackbar.Add(L["Timeline_PlannedCreated"], Severity.Success);
        await LoadDataAsync();
        await TimelineInterop.UpdateAsync(BuildRows());
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        TimelineInterop.MaterializeRequested -= OnMaterializeRequestedAsync;
        await TimelineInterop.DisposeAsync();
    }
}
