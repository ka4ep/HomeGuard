@page "/warranties"
@using System.Globalization
@inject WarrantyApiClient Api
@inject EquipmentApiClient EquipmentApi
@inject DensityPreference Density
@inject IStringLocalizer<Strings> L

<PageTitle>@L["Nav_Warranties"]</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5">@L["Nav_Warranties"]</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <DensitySwitch Surface="@DensitySurface.Warranties"
                       Mode="_density"
                       ModeChanged="m => _density = m" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="() => _dialog.OpenAdd()">
            @L["Common_Add"]
        </MudButton>
    </MudStack>
</MudStack>

<MudTabs Elevation="1" Rounded="true" Class="mb-4"
         @bind-ActivePanelIndex="_tab"
         @bind-ActivePanelIndex:after="LoadAsync">
    <MudTabPanel Text="@TabActiveLabel" />
    <MudTabPanel Text="@TabExpiringLabel" />
</MudTabs>

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">@L["Warranty_Empty"]</MudAlert>
}
else if (_density == DensityMode.List)
{
    <MudTable T="WarrantyDto" Items="_items" Elevation="1" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>@L["Warranty_Name"]</MudTh>
            <MudTh>@L["Warranty_Period"]</MudTh>
            <MudTh>@L["Warranty_Remaining"]</MudTh>
            <MudTh />
        </HeaderContent>
        <RowTemplate Context="w">
            <MudTd DataLabel="@NameLabel">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2" Style="font-weight:600">@EquipmentName(w.EquipmentId)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @w.Name
                    </MudText>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="@PeriodLabel" Class="hg-tabular">
                @ShortDate(w.StartDate) → @ShortDate(w.EndDate)
            </MudTd>
            <MudTd DataLabel="@RemainingLabel">
                <MudChip T="string" Size="Size.Small" Color="@Display.WarrantyColor(w)">
                    @Display.WarrantyLabel(L, w)
                </MudChip>
            </MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="0" Justify="Justify.FlexEnd">
                    <MudIconButton Icon="@Icons.Material.Outlined.AddLink"
                                   Size="Size.Small"
                                   aria-label="@L["Warranty_AddRelated"]"
                                   OnClick="() => _dialog.OpenAddFollowOn(w)" />
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Size="Size.Small"
                                   OnClick="() => _dialog.OpenEdit(w)" />
                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                   Size="Size.Small" Color="Color.Error"
                                   OnClick="() => DeleteAsync(w.Id)" />
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <MudExpansionPanels Elevation="1">
        @foreach (var w in _items)
        {
            <MudExpansionPanel>

                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3"
                              Style="flex-wrap:wrap; width:100%">

                        <MudStack Spacing="0" Style="min-width:160px; flex:1">
                            <MudText Typo="Typo.body1" Style="font-weight:600">@EquipmentName(w.EquipmentId)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @w.Name
                            </MudText>
                        </MudStack>

                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Warranty_Period"]</MudText>
                            <MudText Typo="Typo.body2" Class="hg-tabular">
                                @ShortDate(w.StartDate) → @ShortDate(w.EndDate)
                            </MudText>
                        </MudStack>

                        <MudChip T="string" Size="Size.Small" Color="@Display.WarrantyColor(w)">
                            @Display.WarrantyLabel(L, w)
                        </MudChip>

                    </MudStack>
                </TitleContent>

                <ChildContent>
                    <MudStack Spacing="3">

                        @if (w.Provider is not null || w.ContractNumber is not null || w.Cost.HasValue)
                        {
                            <MudStack Row="true" Spacing="4" Style="flex-wrap:wrap">
                                @if (w.Provider is not null)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Warranty_Provider"]</MudText>
                                        <MudText Typo="Typo.body2">@w.Provider</MudText>
                                    </MudStack>
                                }
                                @if (w.ContractNumber is not null)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Warranty_ContractNumber"]</MudText>
                                        <MudText Typo="Typo.body2">@w.ContractNumber</MudText>
                                    </MudStack>
                                }
                                @if (w.Cost.HasValue)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Warranty_Cost"]</MudText>
                                        <MudText Typo="Typo.body2" Class="hg-tabular">@Money(w.Cost.Value)</MudText>
                                    </MudStack>
                                }
                            </MudStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(w.Notes))
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Warranty_Notes"]</MudText>
                                <MudText Typo="Typo.body2" Style="white-space:pre-line">@w.Notes</MudText>
                            </MudStack>
                        }

                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.AddLink"
                                           Size="Size.Small"
                                           aria-label="@L["Warranty_AddRelated"]"
                                           OnClick="() => _dialog.OpenAddFollowOn(w)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                           Size="Size.Small"
                                           OnClick="() => _dialog.OpenEdit(w)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                           Size="Size.Small" Color="Color.Error"
                                           OnClick="() => DeleteAsync(w.Id)" />
                        </MudStack>

                    </MudStack>
                </ChildContent>

            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

<WarrantyDialog @ref="_dialog" Equipment="_equipment" OnSaved="OnSavedAsync" />

@code {
    private List<WarrantyDto>?       _items;
    private List<EquipmentSummary>   _equipment      = [];
    private Dictionary<Guid, string> _equipmentNames = [];
    private int _tab;
    private WarrantyDialog _dialog = null!;
    private DensityMode _density = DensityMode.Cards;

    private string TabActiveLabel   => L["Warranty_TabActive"];
    private string TabExpiringLabel => L["Warranty_TabExpiring"];
    private string NameLabel        => L["Warranty_Name"];
    private string PeriodLabel      => L["Warranty_Period"];
    private string RemainingLabel   => L["Warranty_Remaining"];

    protected override async Task OnInitializedAsync()
    {
        _density        = await Density.GetAsync(DensitySurface.Warranties);
        _equipment      = await EquipmentApi.GetAllAsync() ?? [];
        _equipmentNames = _equipment.ToDictionary(e => e.Id, e => e.Name);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _items = _tab == 0
            ? await Api.GetActiveAsync()      ?? []
            : await Api.GetExpiringAsync(90)  ?? [];
    }

    private Task OnSavedAsync(WarrantyDto? _) => LoadAsync();

    private async Task DeleteAsync(Guid id)
    {
        await Api.DeleteAsync(id);
        _items?.RemoveAll(w => w.Id == id);
    }

    private string EquipmentName(Guid id) => _equipmentNames.GetValueOrDefault(id, "…");

    private static string ShortDate(DateOnly date)
        => date.ToString("d", CultureInfo.CurrentCulture);

    private static string Money(decimal amount)
        => "€ " + amount.ToString("N2", CultureInfo.CurrentCulture);
}
