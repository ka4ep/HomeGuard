@page "/warranties"
@inject WarrantyApiClient Api
@inject EquipmentApiClient EquipmentApi

<PageTitle>Warranties</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5">Warranties</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => _dialog.OpenAdd()">
        Add
    </MudButton>
</MudStack>

<MudTabs Elevation="1" Rounded="true" Class="mb-4"
         @bind-ActivePanelIndex="_tab"
         @bind-ActivePanelIndex:after="LoadAsync">
    <MudTabPanel Text="Active" />
    <MudTabPanel Text="Expiring soon" />
</MudTabs>

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">No warranties found.</MudAlert>
}
else
{
    <MudExpansionPanels Elevation="1">
        @foreach (var w in _items)
        {
            <MudExpansionPanel>

                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3"
                              Style="flex-wrap:wrap; width:100%">

                        <MudStack Spacing="0" Style="min-width:160px; flex:1">
                            <MudText Typo="Typo.body1" Style="font-weight:600">@w.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(_equipmentNames.GetValueOrDefault(w.EquipmentId, "…"))
                            </MudText>
                        </MudStack>

                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Period</MudText>
                            <MudText Typo="Typo.body2">
                                @w.StartDate.ToString("d MMM yyyy", null) → @w.EndDate.ToString("d MMM yyyy", null)
                            </MudText>
                        </MudStack>

                        <MudChip T="string" Size="Size.Small" Color="@Display.WarrantyColor(w.DaysRemaining)">
                            @Display.WarrantyLabel(w.DaysRemaining)
                        </MudChip>

                    </MudStack>
                </TitleContent>

                <ChildContent>
                    <MudStack Spacing="3">

                        @if (w.Provider is not null || w.ContractNumber is not null)
                        {
                            <MudStack Row="true" Spacing="4" Style="flex-wrap:wrap">
                                @if (w.Provider is not null)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Provider</MudText>
                                        <MudText Typo="Typo.body2">@w.Provider</MudText>
                                    </MudStack>
                                }
                                @if (w.ContractNumber is not null)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Contract №</MudText>
                                        <MudText Typo="Typo.body2">@w.ContractNumber</MudText>
                                    </MudStack>
                                }
                            </MudStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(w.Notes))
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Notes</MudText>
                                <MudText Typo="Typo.body2" Style="white-space:pre-line">@w.Notes</MudText>
                            </MudStack>
                        }

                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                           Size="Size.Small"
                                           OnClick="() => _dialog.OpenEdit(w)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                           Size="Size.Small" Color="Color.Error"
                                           OnClick="() => DeleteAsync(w.Id)" />
                        </MudStack>

                    </MudStack>
                </ChildContent>

            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

<WarrantyDialog @ref="_dialog" Equipment="_equipment" OnSaved="OnSavedAsync" />

@code {
    private List<WarrantyDto>?       _items;
    private List<EquipmentSummary>   _equipment      = [];
    private Dictionary<Guid, string> _equipmentNames = [];
    private int _tab;
    private WarrantyDialog _dialog = null!;

    protected override async Task OnInitializedAsync()
    {
        _equipment      = await EquipmentApi.GetAllAsync() ?? [];
        _equipmentNames = _equipment.ToDictionary(e => e.Id, e => e.Name);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _items = _tab == 0
            ? await Api.GetActiveAsync()      ?? []
            : await Api.GetExpiringAsync(90)  ?? [];
    }

    private Task OnSavedAsync(WarrantyDto? _) => LoadAsync();

    private async Task DeleteAsync(Guid id)
    {
        await Api.DeleteAsync(id);
        _items?.RemoveAll(w => w.Id == id);
    }
}
