@page "/warranties"
@inject WarrantyApiClient Api
@inject EquipmentApiClient EquipmentApi

<PageTitle>Warranties</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5">Warranties</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddDialog">
        Add
    </MudButton>
</MudStack>

<MudTabs Elevation="1" Rounded="true" Class="mb-4"
         @bind-ActivePanelIndex="_tab"
         @bind-ActivePanelIndex:after="LoadAsync">
    <MudTabPanel Text="Active" />
    <MudTabPanel Text="Expiring soon" />
</MudTabs>

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">No warranties found.</MudAlert>
}
else
{
    <MudExpansionPanels Elevation="1">
        @foreach (var w in _items)
        {
            <MudExpansionPanel>

                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3"
                              Style="flex-wrap:wrap; width:100%">

                        <MudStack Spacing="0" Style="min-width:160px; flex:1">
                            <MudText Typo="Typo.body1" Style="font-weight:600">@w.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(_equipmentNames.GetValueOrDefault(w.EquipmentId, "…"))
                            </MudText>
                        </MudStack>

                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Period</MudText>
                            <MudText Typo="Typo.body2">
                                @w.StartDate.ToString("d MMM yyyy", null) → @w.EndDate.ToString("d MMM yyyy", null)
                            </MudText>
                        </MudStack>

                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(w.DaysRemaining)">
                            @StatusLabel(w.DaysRemaining)
                        </MudChip>

                    </MudStack>
                </TitleContent>

                <ChildContent>
                    <MudStack Spacing="3">

                        @if (w.Provider is not null || w.ContractNumber is not null)
                        {
                            <MudStack Row="true" Spacing="4" Style="flex-wrap:wrap">
                                @if (w.Provider is not null)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Provider</MudText>
                                        <MudText Typo="Typo.body2">@w.Provider</MudText>
                                    </MudStack>
                                }
                                @if (w.ContractNumber is not null)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Contract №</MudText>
                                        <MudText Typo="Typo.body2">@w.ContractNumber</MudText>
                                    </MudStack>
                                }
                            </MudStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(w.Notes))
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Notes</MudText>
                                <MudText Typo="Typo.body2" Style="white-space:pre-line">@w.Notes</MudText>
                            </MudStack>
                        }

                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                           Size="Size.Small"
                                           OnClick="() => OpenEditDialog(w)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                           Size="Size.Small" Color="Color.Error"
                                           OnClick="() => DeleteAsync(w.Id)" />
                        </MudStack>

                    </MudStack>
                </ChildContent>

            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

<MudDialog @bind-Visible="_showDialog">
    <TitleContent>@(_editId.HasValue ? "Edit warranty" : "Add warranty")</TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect @bind-Value="_form.EquipmentId" Label="Equipment" Required="true">
                    @foreach (var e in _equipment)
                    {
                        <MudSelectItem Value="@e.Id">@e.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_form.Name" Label="Name" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_form.StartDateNullable" Label="Start date"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_form.EndDateNullable" Label="End date"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_form.Provider" Label="Provider" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_form.ContractNumber" Label="Contract number" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_form.Notes" Label="Notes"
                              Lines="3" Sizing="InputSizing.Auto" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showDialog = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveAsync" Disabled="_saving">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<WarrantyDto>?        _items;
    private List<EquipmentSummary>    _equipment      = [];
    private Dictionary<Guid, string>  _equipmentNames = [];
    private int   _tab;
    private bool  _showDialog;
    private bool  _saving;
    private Guid? _editId;
    private WarrantyFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        _equipment      = await EquipmentApi.GetAllAsync() ?? [];
        _equipmentNames = _equipment.ToDictionary(e => e.Id, e => e.Name);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _items = _tab == 0
            ? await Api.GetActiveAsync()      ?? []
            : await Api.GetExpiringAsync(90)  ?? [];
    }

    private void OpenAddDialog()
    {
        _editId = null;
        _form   = new WarrantyFormModel { EquipmentId = _equipment.FirstOrDefault()?.Id ?? Guid.Empty };
        _showDialog = true;
    }

    private void OpenEditDialog(WarrantyDto w)
    {
        _editId = w.Id;
        _form   = new WarrantyFormModel
        {
            EquipmentId       = w.EquipmentId,
            Name              = w.Name,
            Provider          = w.Provider,
            ContractNumber    = w.ContractNumber,
            Notes             = w.Notes,
            StartDateNullable = w.StartDate.ToDateTime(TimeOnly.MinValue),
            EndDateNullable   = w.EndDate.ToDateTime(TimeOnly.MinValue),
        };
        _showDialog = true;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        if (_editId.HasValue)
        {
            await Api.UpdateAsync(_editId.Value, new UpdateWarrantyDto(
                _form.Name, _form.StartDate, _form.EndDate,
                _form.Provider, _form.ContractNumber, _form.Notes));
        }
        else
        {
            await Api.CreateAsync(new CreateWarrantyDto(
                _form.EquipmentId, _form.Name, _form.StartDate, _form.EndDate,
                _form.Provider, _form.ContractNumber, _form.Notes));
        }
        await LoadAsync();
        _saving     = false;
        _showDialog = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        await Api.DeleteAsync(id);
        _items?.RemoveAll(w => w.Id == id);
    }

    private static Color StatusColor(int days) => days switch
    {
        < 0   => Color.Default,
        <= 7  => Color.Error,
        <= 30 => Color.Warning,
        _     => Color.Success,
    };

    private static string StatusLabel(int days) => days switch
    {
        < 0   => "Expired",
        0     => "Today",
        1     => "Tomorrow",
        <= 30 => $"{days}d left",
        _     => $"{days / 30}mo left",
    };

    private sealed class WarrantyFormModel : HomeGuard.Client.Common.WarrantyFormModel
    {
        public Guid EquipmentId { get; set; }
    }
}
