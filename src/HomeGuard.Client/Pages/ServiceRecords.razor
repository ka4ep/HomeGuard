@page "/service"
@inject ServiceRecordApiClient Api
@inject EquipmentApiClient EquipmentApi

<PageTitle>Service records</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5">Service records</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => _dialog.OpenAdd()">
        Add
    </MudButton>
</MudStack>

<MudTabs Elevation="1" Rounded="true" Class="mb-4" @bind-ActivePanelIndex="_tab"
         @bind-ActivePanelIndex:after="LoadAsync">
    <MudTabPanel Text="Due soon" />
    <MudTabPanel Text="Overdue" />
</MudTabs>

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info">Nothing here.</MudAlert>
}
else
{
    <MudExpansionPanels Elevation="1">
        @foreach (var sr in _items)
        {
            <MudExpansionPanel>

                @* ── Заголовок панели ────────────────────────────────────── *@
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3"
                              Style="flex-wrap:wrap; width:100%">

                        @* Название + оборудование *@
                        <MudStack Spacing="0" Style="min-width:160px; flex:1">
                            <MudText Typo="Typo.body1" Style="font-weight:600">@sr.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(_equipmentNames.GetValueOrDefault(sr.EquipmentId, "…"))
                            </MudText>
                        </MudStack>

                        @* Даты *@
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Service date</MudText>
                            <MudText Typo="Typo.body2">@sr.ServiceDate.ToString("d MMM yyyy", null)</MudText>
                        </MudStack>

                        @* Статус *@
                        <div>
                            @if (sr.IsOverdue)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">Overdue</MudChip>
                            }
                            else if (sr.DaysUntilNextService.HasValue)
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(sr.DaysUntilNextService <= 7 ? Color.Warning : Color.Default)">
                                    @Display.ServiceDaysLabel(sr.DaysUntilNextService)
                                </MudChip>
                            }
                        </div>

                    </MudStack>
                </TitleContent>

                @* ── Детали (разворачиваются) ────────────────────────────── *@
                <ChildContent>
                    <MudStack Spacing="3">

                        @* Цена + одометр — только если есть значение *@
                        @if (sr.Cost.HasValue || sr.MeterReading.HasValue)
                        {
                            <MudStack Row="true" Spacing="4" Style="flex-wrap:wrap">
                                @if (sr.Cost.HasValue)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Cost</MudText>
                                        <MudText Typo="Typo.body2">€ @sr.Cost.Value.ToString("F2", null)</MudText>
                                    </MudStack>
                                }
                                @if (sr.MeterReading.HasValue)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Meter reading</MudText>
                                        <MudText Typo="Typo.body2">@sr.MeterReading</MudText>
                                    </MudStack>
                                }
                                @if (sr.ServiceProvider is not null)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Provider</MudText>
                                        <MudText Typo="Typo.body2">@sr.ServiceProvider</MudText>
                                    </MudStack>
                                }
                            </MudStack>
                        }

                        @* Notes — сохраняем переносы строк *@
                        @if (!string.IsNullOrWhiteSpace(sr.Notes))
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Notes</MudText>
                                <MudText Typo="Typo.body2" Style="white-space:pre-line">@sr.Notes</MudText>
                            </MudStack>
                        }

                        @* Кнопки *@
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                           Size="Size.Small"
                                           OnClick="() => _dialog.OpenEdit(sr)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                           Size="Size.Small" Color="Color.Error"
                                           OnClick="() => DeleteAsync(sr.Id)" />
                        </MudStack>

                    </MudStack>
                </ChildContent>

            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

<ServiceRecordDialog @ref="_dialog" Equipment="_equipment" DefaultStatus="Planned"
                     OnSaved="OnSavedAsync" />

@code {
    private List<ServiceRecordDto>?  _items;
    private List<EquipmentSummary>   _equipment      = [];
    private Dictionary<Guid, string> _equipmentNames = [];
    private int _tab;
    private ServiceRecordDialog _dialog = null!;

    protected override async Task OnInitializedAsync()
    {
        _equipment      = await EquipmentApi.GetAllAsync() ?? [];
        _equipmentNames = _equipment.ToDictionary(e => e.Id, e => e.Name);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _items = _tab == 0
            ? await Api.GetDueSoonAsync(90) ?? []
            : await Api.GetOverdueAsync()  ?? [];
    }

    private Task OnSavedAsync(ServiceRecordDto? _) => LoadAsync();

    private async Task DeleteAsync(Guid id)
    {
        await Api.DeleteAsync(id);
        _items?.RemoveAll(sr => sr.Id == id);
    }
}
