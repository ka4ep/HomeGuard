@* Add/edit warranty dialog — shared by the Warranties page (equipment select)
   and WarrantySection on EquipmentDetail (fixed equipment). Owns the save call;
   parents open it via @ref (OpenAdd/OpenEdit/OpenAddFollowOn) and reload on OnSaved. *@
@namespace HomeGuard.Client.Common
@inject WarrantyApiClient Api
@inject IStringLocalizer<Strings> L

<MudDialog @bind-Visible="_visible">
    <TitleContent>@(_editId.HasValue ? L["Warranty_DialogEdit"] : L["Warranty_DialogAdd"])</TitleContent>
    <DialogContent>
        <MudGrid>
            @if (FixedEquipmentId is null)
            {
                <MudItem xs="12">
                    <MudSelect T="Guid" Value="_equipmentId" ValueChanged="OnEquipmentChanged"
                               Label=@(L["Nav_Equipment"]) Required="true"
                               Disabled="_editId.HasValue">
                        @foreach (var e in Equipment)
                        {
                            <MudSelectItem Value="@e.Id">@e.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12">
                <MudTextField @bind-Value="_form.Name" Label=@(L["Form_Name"]) Required="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @L["Warranty_Duration"]: @WarrantyFormModel.YearsLabel(L, _form.DurationHalfYears)
                </MudText>
                <MudSlider T="int" Value="_form.DurationHalfYears" ValueChanged="OnDurationChanged"
                           Min="0" Max="20" Step="1" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker Date="_form.StartDateNullable" DateChanged="OnStartDateChanged"
                               Label=@(L["Form_StartDate"]) DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker Date="_form.EndDateNullable" DateChanged="OnEndDateChanged"
                               Label=@(L["Form_EndDate"]) DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_form.Provider" Label=@(L["Warranty_Provider"]) />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_form.ContractNumber" Label=@(L["Warranty_ContractNumber"]) />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="_form.Cost" Label="@L["Warranty_Cost"]" Format="F2"
                                 Adornment="Adornment.Start" AdornmentText="€" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_form.Notes" Label=@(L["Form_Notes"])
                              Lines="3" Sizing="InputSizing.Auto" />
            </MudItem>
        </MudGrid>

        @if (_editId.HasValue)
        {
            <AttachmentsCard OwnerEntityId="_editId.Value" OwnerEntityType="Warranty"
                             EmptyText="@L["Warranty_AttachmentsEmpty"]" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _visible = false">@L["Common_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveAsync" Disabled="_saving">@L["Common_Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>All equipment to choose from; ignored when FixedEquipmentId is set.</summary>
    [Parameter] public List<EquipmentSummary> Equipment { get; set; } = [];

    /// <summary>When set, the equipment is fixed (dialog opened from an equipment page).</summary>
    [Parameter] public Guid? FixedEquipmentId { get; set; }

    /// <summary>Purchase date for the fixed equipment — WarrantySection knows only the
    /// bare EquipmentId, not the full EquipmentSummary the standalone Warranties page
    /// picks from, so it has to be threaded through separately.</summary>
    [Parameter] public DateOnly? FixedEquipmentPurchaseDate { get; set; }

    /// <summary>The created/updated warranty, or null if the API returned nothing.</summary>
    [Parameter] public EventCallback<WarrantyDto?> OnSaved { get; set; }

    private bool  _visible;
    private bool  _saving;
    private Guid? _editId;
    private Guid  _equipmentId;
    private WarrantyFormModel _form = new();

    private DateOnly? ResolvePurchaseDate(Guid equipmentId) =>
        FixedEquipmentId is not null
            ? FixedEquipmentPurchaseDate
            : Equipment.FirstOrDefault(e => e.Id == equipmentId)?.PurchaseDate;

    public void OpenAdd()
    {
        _editId      = null;
        _equipmentId = FixedEquipmentId ?? Equipment.FirstOrDefault()?.Id ?? Guid.Empty;

        _form = new WarrantyFormModel { Name = L["Warranty_DefaultName"] };
        if (ResolvePurchaseDate(_equipmentId) is { } start)
        {
            _form.StartDateNullable = start.ToDateTime(TimeOnly.MinValue);
            _form.EndDateNullable   = WarrantyFormModel.ComputeEnd(_form.StartDateNullable.Value, _form.DurationHalfYears);
        }

        _visible = true;
        StateHasChanged();
    }

    /// <summary>Pre-fills a new warranty as the continuation of an existing one — for a
    /// device where different parts carry their own separately-timed warranties, each
    /// chain is started from the specific warranty it continues, not from some single
    /// "the equipment's latest warranty" guess.</summary>
    public void OpenAddFollowOn(WarrantyDto previous)
    {
        _editId      = null;
        _equipmentId = previous.EquipmentId;

        _form = new WarrantyFormModel { Name = previous.Name, Provider = previous.Provider };
        var start = previous.EndDate.AddDays(1).ToDateTime(TimeOnly.MinValue);
        _form.StartDateNullable = start;
        _form.EndDateNullable   = WarrantyFormModel.ComputeEnd(start, _form.DurationHalfYears);

        _visible = true;
        StateHasChanged();
    }

    /// <summary>Re-anchoring on equipment choice is Add-only — an existing warranty's
    /// dates are never silently rewritten just because someone reopened the dialog.</summary>
    private void OnEquipmentChanged(Guid id)
    {
        _equipmentId = id;
        if (_editId.HasValue) return;

        if (ResolvePurchaseDate(id) is { } purchase)
        {
            _form.StartDateNullable = purchase.ToDateTime(TimeOnly.MinValue);
            _form.EndDateNullable   = WarrantyFormModel.ComputeEnd(_form.StartDateNullable.Value, _form.DurationHalfYears);
        }
    }

    private void OnDurationChanged(int halfYears)
    {
        _form.DurationHalfYears = halfYears;
        if (_form.StartDateNullable is { } start)
            _form.EndDateNullable = WarrantyFormModel.ComputeEnd(start, halfYears);
    }

    private void OnStartDateChanged(DateTime? start)
    {
        _form.StartDateNullable = start;
        if (start is { } s)
            _form.EndDateNullable = WarrantyFormModel.ComputeEnd(s, _form.DurationHalfYears);
    }

    /// <summary>Typing an end date directly (rather than via the slider) moves the slider
    /// to match — rounded down to the nearest half-year mark it doesn't overshoot.</summary>
    private void OnEndDateChanged(DateTime? end)
    {
        _form.EndDateNullable = end;
        if (_form.StartDateNullable is { } start && end is { } e)
            _form.DurationHalfYears = WarrantyFormModel.InferDurationHalfYears(start, e);
    }

    public void OpenEdit(WarrantyDto w)
    {
        _editId      = w.Id;
        _equipmentId = w.EquipmentId;
        var start = w.StartDate.ToDateTime(TimeOnly.MinValue);
        var end   = w.EndDate.ToDateTime(TimeOnly.MinValue);
        _form = new WarrantyFormModel
        {
            Name              = w.Name,
            Provider          = w.Provider,
            ContractNumber    = w.ContractNumber,
            Cost              = w.Cost,
            Notes             = w.Notes,
            StartDateNullable = start,
            EndDateNullable   = end,
            DurationHalfYears = WarrantyFormModel.InferDurationHalfYears(start, end),
        };
        _visible = true;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var result = _editId.HasValue
            ? await Api.UpdateAsync(_editId.Value, new UpdateWarrantyDto(
                _form.Name, _form.StartDate, _form.EndDate,
                _form.Provider, _form.ContractNumber, _form.Notes, _form.Cost))
            : await Api.CreateAsync(new CreateWarrantyDto(
                _equipmentId, _form.Name, _form.StartDate, _form.EndDate,
                _form.Provider, _form.ContractNumber, _form.Notes, _form.Cost));
        _saving  = false;
        _visible = false;
        await OnSaved.InvokeAsync(result);
    }
}
