@namespace HomeGuard.Client.Common
@using System.Globalization
@inject ContractApiClient Api
@inject IStringLocalizer<Strings> L

@*
    The whole point of this dialog is the preview: an early payment is only worth making
    once the household has seen what it does, so the numbers are computed by the server on
    every change and nothing is written until the button at the bottom is pressed.

    Interest savings appear only when a rate is on the plan — without one there is nothing
    honest to say, and the dialog stays quiet rather than guessing.
*@
<MudDialog @bind-Visible="_visible" Options="_options">
    <TitleContent>@L["Early_Title"]</TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal?" @bind-Value="_amount" @bind-Value:after="RefreshAsync"
                                 Format="F2" Min="0" Label=@(L["Early_Amount"])
                                 HelperText=@(BalanceHelp) />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_paidOn" @bind-Date:after="RefreshAsync"
                               Label=@(L["Early_Date"]) DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12">
                <MudRadioGroup T="EarlyPaymentEffect" @bind-Value="_effect" @bind-Value:after="RefreshAsync">
                    <MudRadio Value="EarlyPaymentEffect.ReduceTerm" Color="Color.Primary">
                        @L["Early_ReduceTerm"]
                    </MudRadio>
                    <MudRadio Value="EarlyPaymentEffect.ReducePayment" Color="Color.Primary">
                        @L["Early_ReducePayment"]
                    </MudRadio>
                </MudRadioGroup>
            </MudItem>
        </MudGrid>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-3" />
        }

        @if (_preview is { } p)
        {
            <MudPaper Elevation="0" Class="mt-4 pa-3"
                      Style="background:var(--hg-bg-raised); border-radius:var(--hg-radius-md)">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Revision_Preview"]</MudText>

                @if (p.Gap == LoanEstimateGap.MissingBalance)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Early_GapMissingBalance"]</MudText>
                }
                else if (p.PaysOffEverything)
                {
                    <MudText Typo="Typo.body2" Style="color:var(--hg-money)">@L["Early_PaysOff"]</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0" Style="background:transparent">
                        <thead>
                            <tr>
                                <th></th>
                                <th style="text-align:right">@L["Revision_Before"]</th>
                                <th style="text-align:right">@L["Revision_After"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@L["Contract_Balance"]</td>
                                <td class="hg-tabular" style="text-align:right; color:var(--hg-text-muted)">
                                    @Money(p.BalanceBefore)
                                </td>
                                <td class="hg-tabular" style="text-align:right; font-weight:600">
                                    @Money(p.BalanceAfter)
                                </td>
                            </tr>
                            <tr>
                                <td>@L["Contract_Installment"]</td>
                                <td class="hg-tabular" style="text-align:right; color:var(--hg-text-muted)">
                                    @Money(p.Before.Installment)
                                </td>
                                <td class="hg-tabular" style="text-align:right; font-weight:600;
                                           @(p.After.Installment != p.Before.Installment ? "color:var(--hg-money)" : "")">
                                    @Money(p.After.Installment)
                                </td>
                            </tr>
                            <tr>
                                <td>@L["Revision_Remaining"]</td>
                                <td class="hg-tabular" style="text-align:right; color:var(--hg-text-muted)">
                                    @p.Before.InstallmentsLeft
                                </td>
                                <td class="hg-tabular" style="text-align:right; font-weight:600;
                                           @(p.After.InstallmentsLeft != p.Before.InstallmentsLeft ? "color:var(--hg-money)" : "")">
                                    @p.After.InstallmentsLeft
                                </td>
                            </tr>
                            <tr>
                                <td>@L["Contract_Payoff"]</td>
                                <td class="hg-tabular" style="text-align:right; color:var(--hg-text-muted)">
                                    @ShortDate(p.Before.PayoffDate)
                                </td>
                                <td class="hg-tabular" style="text-align:right; font-weight:600">
                                    @ShortDate(p.After.PayoffDate)
                                </td>
                            </tr>
                            @if (p.RateKnown)
                            {
                                <tr>
                                    <td>@L["Contract_InterestLeft"]</td>
                                    <td class="hg-tabular" style="text-align:right; color:var(--hg-text-muted)">
                                        @Money(p.Before.InterestRemaining)
                                    </td>
                                    <td class="hg-tabular" style="text-align:right; font-weight:600">
                                        @Money(p.After.InterestRemaining)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }

                @if (p is { RateKnown: true, InterestSaved: { } saved })
                {
                    <MudText Typo="Typo.body2" Class="mt-2" Style="color:var(--hg-money); font-weight:600">
                        @L["Early_Saved", Money(saved)]
                    </MudText>
                }

                @if (p.Gap == LoanEstimateGap.MissingRate)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                        @L["Revision_GapMissingRate"]
                    </MudText>
                }

                @if (p.Gap != LoanEstimateGap.MissingBalance)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                        @L["Early_TakesEffect", ShortDate(p.EffectiveFrom)]
                    </MudText>
                }
            </MudPaper>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _visible = false">@L["Common_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CommitAsync"
                   Disabled="@(_saving || _preview is null || _preview.Gap == LoanEstimateGap.MissingBalance)">
            @L["Early_Commit"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public Guid ContractId { get; set; }
    [Parameter, EditorRequired] public string Currency { get; set; } = "EUR";

    /// <summary>What is owed now — shown as a hint so the amount is typed against something.</summary>
    [Parameter] public decimal? Balance { get; set; }

    [Parameter] public EventCallback OnSaved { get; set; }

    private readonly DialogOptions _options = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private bool _visible;
    private bool _loading;
    private bool _saving;
    private string? _error;

    private decimal? _amount;
    private DateTime? _paidOn = DateTime.Today;
    private EarlyPaymentEffect _effect = EarlyPaymentEffect.ReduceTerm;
    private EarlyPaymentPreviewDto? _preview;

    private CancellationTokenSource? _refreshCts;

    private string? BalanceHelp => Balance is { } b ? L["Early_BalanceHelp", Money(b)].Value : null;

    public void Open()
    {
        _amount  = null;
        _paidOn  = DateTime.Today;
        _effect  = EarlyPaymentEffect.ReduceTerm;
        _preview = null;
        _error   = null;
        _visible = true;
        StateHasChanged();
    }

    private EarlyPaymentRequestDto? Request()
        => _amount is > 0 and var amount
            ? new EarlyPaymentRequestDto(
                amount, DateOnly.FromDateTime(_paidOn ?? DateTime.Today), _effect)
            : null;

    private async Task RefreshAsync()
    {
        // A slow answer to an older question must not overwrite a newer one.
        _refreshCts?.Cancel();
        _refreshCts = new CancellationTokenSource();
        var token = _refreshCts.Token;

        _error = null;

        if (Request() is not { } request)
        {
            _preview = null;
            return;
        }

        _loading = true;
        try
        {
            var result = await Api.PreviewEarlyPaymentAsync(ContractId, request, token);
            if (token.IsCancellationRequested) return;

            _preview = result.Value;
            _error   = result.Error;
        }
        catch (OperationCanceledException)
        {
            // superseded by a newer request
        }
        finally
        {
            if (!token.IsCancellationRequested) _loading = false;
        }
    }

    private async Task CommitAsync()
    {
        if (Request() is not { } request) return;

        _saving = true;
        _error  = null;
        try
        {
            var result = await Api.CommitEarlyPaymentAsync(ContractId, request);
            if (!result.Ok)
            {
                _error = result.Error ?? L["Early_Failed"];
                return;
            }

            _visible = false;
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private static string ShortDate(DateOnly? date)
        => date is { } d ? d.ToString("d", CultureInfo.CurrentCulture) : "—";

    private string Money(decimal amount)
        => $"{amount.ToString("N2", CultureInfo.CurrentCulture)} {ContractFormat.CurrencySymbol(Currency)}";
}
