@namespace HomeGuard.Client.Common
@inject ContractApiClient Api
@inject IStringLocalizer<Strings> L

@*
    Correcting a single payment: a wrong date, a wrong amount, or a row marked paid by
    mistake. The last one matters most — without a way back, one stray tap leaves the
    totals wrong forever and there is nothing on screen to explain why.
*@
<MudDialog @bind-Visible="_visible" Options="_options">
    <TitleContent>@L["Payment_EditTitle"]</TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_dueDateNullable" Label=@(L["Payment_DueDate"])
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="_amountDue" Format="F2" Label=@(L["Payment_Amount"]) />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_kind" Label=@(L["Payment_Kind"])>
                    @foreach (var kind in Kinds)
                    {
                        var label = L["PaymentKind_" + kind];
                        <MudSelectItem Value="@kind">@label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_note" Label=@(L["Meter_Note"]) />
            </MudItem>

            @if (_wasPaid)
            {
                <MudItem xs="12">
                    <MudSwitch @bind-Value="_reopen" Color="Color.Warning"
                               Label=@(L["Payment_Reopen"]) />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @L["Payment_ReopenHelp"]
                    </MudText>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" OnClick="DeleteAsync" Disabled="_saving">
            @L["Common_Delete"]
        </MudButton>
        <MudSpacer />
        <MudButton OnClick="() => _visible = false">@L["Common_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveAsync" Disabled="_saving">
            @L["Common_Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private static readonly PaymentKind[] Kinds =
        [PaymentKind.Scheduled, PaymentKind.Extra, PaymentKind.DownPayment,
         PaymentKind.Residual, PaymentKind.Fee, PaymentKind.Refund];

    private readonly DialogOptions _options = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    private bool _visible;
    private bool _saving;
    private bool _wasPaid;
    private bool _reopen;

    private Guid _paymentId;
    private DateTime? _dueDateNullable;
    private decimal _amountDue;
    private PaymentKind _kind = PaymentKind.Scheduled;
    private string? _note;

    public void Open(PaymentDto payment)
    {
        _paymentId       = payment.Id;
        _dueDateNullable = payment.DueDate.ToDateTime(TimeOnly.MinValue);
        _amountDue       = payment.AmountDue;
        _kind            = payment.Kind;
        _note            = payment.Note;
        _wasPaid         = payment.Status == PaymentStatus.Paid;
        _reopen          = false;
        _visible         = true;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var due = _dueDateNullable is { } d
                ? DateOnly.FromDateTime(d)
                : DateOnly.FromDateTime(DateTime.Today);

            await Api.UpdatePaymentAsync(_paymentId,
                new UpdatePaymentDto(due, _amountDue, _kind, _note, _reopen));

            _visible = false;
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        _saving = true;
        try
        {
            await Api.DeletePaymentAsync(_paymentId);
            _visible = false;
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }
}
