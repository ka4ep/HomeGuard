@namespace HomeGuard.Client.Common
@using System.Globalization
@inject ContractApiClient Api
@inject IStringLocalizer<Strings> L

@*
    Corrections append a revision, never edit the plan in place — so this dialog's real
    job is to show what the change does before it is committed. The generic diff (below)
    is computed from the plan itself: instalment, interval, how many are left, when the
    last one falls.

    For a loan or lease, "Balance & rate" lets the household record what a plain price
    change never needed — and when Reason is EarlyPayment, the assist panel underneath
    turns a lump sum into the resulting instalment/term via the server's amortisation
    math (contracts-spec.md §4.1), pre-filling the fields above so the same diff table
    shows the consequence. Missing a rate or a balance never blocks this — the assist
    still returns a term/payment estimate, just without an interest-saved figure, per the
    fallback ladder in §6.
*@
<MudDialog @bind-Visible="_visible" Options="_options">
    <TitleContent>@L["Revision_Title"]</TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_form.Reason" Label=@(L["Revision_Reason"])>
                    @foreach (var reason in Reasons)
                    {
                        var label = L["RevisionReason_" + reason];
                        <MudSelectItem Value="@reason">@label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_form.EffectiveFromNullable"
                               Label=@(L["Revision_EffectiveFrom"]) DateFormat="yyyy-MM-dd"
                               HelperText=@(L["Revision_EffectiveHelp"]) />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="_form.InstallmentAmount" Format="F2"
                                 Label=@(L["Contract_Installment"]) />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect @bind-Value="_form.IntervalMonths" Label=@(L["Contract_Interval"])>
                    @foreach (var months in Intervals)
                    {
                        var label = IntervalLabel(months);
                        <MudSelectItem Value="@months">@label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="_form.InstallmentCount" Min="1"
                                 Label=@(L["Contract_Count"])
                                 HelperText=@(L["Contract_CountHelp"]) />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_form.Note" Label=@(L["Form_Notes"]) />
            </MudItem>
        </MudGrid>

        @if (IsLoanLike)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">@L["Revision_BalanceAndRate"]</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_form.RemainingPrincipal" Format="F2"
                                     Label=@(L["Revision_RemainingPrincipal"])
                                     HelperText=@(L["Revision_RemainingPrincipalHelp"]) />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_form.AnnualInterestRatePercent" Format="F2"
                                     Label=@(L["Revision_AnnualRate"])
                                     Adornment="Adornment.End" AdornmentText="%"
                                     HelperText=@(L["Revision_AnnualRateHelp"]) />
                </MudItem>
            </MudGrid>
        }

        @if (_form.Reason == RevisionReason.EarlyPayment)
        {
            <MudPaper Elevation="0" Class="mt-4 pa-3"
                      Style="background:var(--hg-bg-raised); border-radius:var(--hg-radius-md)">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Revision_EarlyPaymentAssist"]</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="5">
                        <MudNumericField @bind-Value="_form.ExtraAmount" Format="F2"
                                         Label=@(L["Revision_ExtraAmount"]) />
                    </MudItem>
                    <MudItem xs="12" sm="7">
                        <MudRadioGroup @bind-Value="_form.Effect">
                            <MudRadio Value="EarlyPaymentEffect.ReduceTerm" Dense="true">
                                @L["Revision_EffectReduceTerm"]
                            </MudRadio>
                            <MudRadio Value="EarlyPaymentEffect.ReducePayment" Dense="true">
                                @L["Revision_EffectReducePayment"]
                            </MudRadio>
                        </MudRadioGroup>
                    </MudItem>
                </MudGrid>

                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-2"
                           OnClick="CalculateEarlyPaymentAsync"
                           Disabled="@(_calculating || _form.ExtraAmount is not > 0)">
                    @L["Revision_Calculate"]
                </MudButton>

                @if (_earlyPreview is { } preview)
                {
                    <MudStack Spacing="1" Class="mt-3">
                        <MudText Typo="Typo.body2">
                            @L["Revision_InstallmentsLeft", preview.InstallmentsBefore, preview.InstallmentsAfter]
                        </MudText>
                        @if (preview.InterestSaved is { } saved)
                        {
                            <MudText Typo="Typo.body2" Style="color:var(--hg-money); font-weight:600">
                                @L["Revision_InterestSaved", Money(saved)]
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(preview.Gap == LoanEstimateGap.MissingBalance
                                    ? L["Revision_GapMissingBalance"]
                                    : L["Revision_GapMissingRate"])
                            </MudText>
                        }
                    </MudStack>
                }
            </MudPaper>
        }

        @* ── было → станет ────────────────────────────────────────────────── *@
        <MudPaper Elevation="0" Class="mt-4 pa-3"
                  Style="background:var(--hg-bg-raised); border-radius:var(--hg-radius-md)">
            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Revision_Preview"]</MudText>

            <MudSimpleTable Dense="true" Elevation="0" Style="background:transparent">
                <thead>
                    <tr>
                        <th></th>
                        <th style="text-align:right">@L["Revision_Before"]</th>
                        <th style="text-align:right">@L["Revision_After"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in PreviewRows)
                    {
                        <tr>
                            <td>@row.Label</td>
                            <td class="hg-tabular" style="text-align:right; color:var(--hg-text-muted)">
                                @row.Before
                            </td>
                            <td class="hg-tabular" style="text-align:right; font-weight:600;
                                       @(row.Changed ? "color:var(--hg-money)" : "")">
                                @row.After
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            @if (Current?.InstallmentCount is null && _form.InstallmentCount is null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                    @L["Revision_OpenEndedNote"]
                </MudText>
            }
        </MudPaper>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _visible = false">@L["Common_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveAsync"
                   Disabled="@(_saving || _form.InstallmentAmount is null)">
            @L["Revision_Commit"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public Guid ContractId { get; set; }
    [Parameter, EditorRequired] public string Currency { get; set; } = "EUR";
    [Parameter] public ContractKind Kind { get; set; }

    /// <summary>The revision in force — the left column of the diff.</summary>
    [Parameter] public PlanRevisionDto? Current { get; set; }

    /// <summary>How many instalments are already behind us, opening position included.</summary>
    [Parameter] public int InstallmentsPaid { get; set; }

    [Parameter] public EventCallback OnSaved { get; set; }

    private bool IsLoanLike => Kind is ContractKind.Loan or ContractKind.Lease;

    private static readonly RevisionReason[] Reasons =
        [RevisionReason.PriceChange, RevisionReason.TermChange, RevisionReason.EarlyPayment,
         RevisionReason.AddOn, RevisionReason.Pause, RevisionReason.Correction];

    private static readonly int[] Intervals = [1, 3, 6, 12];

    private readonly DialogOptions _options = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private bool _visible;
    private bool _saving;
    private bool _calculating;
    private string? _error;
    private RevisionFormModel _form = new();
    private EarlyPaymentPreviewDto? _earlyPreview;

    public void Open()
    {
        _error = null;
        _earlyPreview = null;
        _form = new RevisionFormModel
        {
            InstallmentAmount        = Current?.EffectiveInstallment,
            IntervalMonths           = Current?.IntervalMonths ?? 1,
            InstallmentCount         = Current?.InstallmentCount,
            RemainingPrincipal       = Current?.RemainingPrincipal,
            AnnualInterestRatePercent = Current?.AnnualInterestRate * 100m,
        };
        _visible = true;
        StateHasChanged();
    }

    /// <summary>
    /// Turns the extra amount into a term/payment estimate via the server's amortisation
    /// math, then folds the result straight into the plan fields above — the existing
    /// "было → станет" table is what actually shows it, so this button does not need its
    /// own diff view.
    /// </summary>
    private async Task CalculateEarlyPaymentAsync()
    {
        if (_form.ExtraAmount is not { } extra || extra <= 0) return;

        _calculating = true;
        try
        {
            var preview = await Api.PreviewEarlyPaymentAsync(
                ContractId, new EarlyPaymentPreviewRequestDto(extra, _form.Effect));

            _earlyPreview = preview;
            if (preview is { InstallmentsAfter: > 0 })
            {
                _form.InstallmentCount   = preview.InstallmentsAfter;
                _form.InstallmentAmount  = preview.InstallmentAmountAfter;
            }
        }
        finally
        {
            _calculating = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_form.InstallmentAmount is not { } amount) return;

        _saving = true;
        _error  = null;
        try
        {
            var result = await Api.AddRevisionAsync(ContractId, new AddRevisionDto(
                EffectiveFrom:      _form.EffectiveFrom,
                Reason:             _form.Reason,
                FirstDueDate:       _form.EffectiveFrom,
                IntervalMonths:     _form.IntervalMonths,
                InstallmentAmount:  amount,
                InstallmentCount:   _form.InstallmentCount,
                RemainingPrincipal: IsLoanLike ? _form.RemainingPrincipal : null,
                AnnualInterestRate: IsLoanLike ? _form.AnnualInterestRatePercent / 100m : null,
                Note:               _form.Note));

            if (result is null)
            {
                // Сервер отказывает, если ревизия начинается раньше действующей.
                _error = L["Revision_TooEarly"];
                return;
            }

            // Записываем сам досрочный платёж отдельной строкой — иначе деньги ушли,
            // а в истории и в итогах контракта это никак не отразится.
            if (_form.Reason == RevisionReason.EarlyPayment && _form.ExtraAmount is { } extra && extra > 0)
            {
                var payment = await Api.AddPaymentAsync(ContractId, new AddPaymentDto(
                    DueDate: _form.EffectiveFrom, AmountDue: extra, Kind: PaymentKind.Extra,
                    Note: L["Revision_ExtraPaymentNote"]));

                if (payment is not null)
                    await Api.ConfirmPaymentAsync(payment.Id, new ConfirmPaymentDto(_form.EffectiveFrom, extra));
            }

            _visible = false;
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Preview ──────────────────────────────────────────────────────────────

    private sealed record PreviewRow(string Label, string Before, string After, bool Changed);

    private IEnumerable<PreviewRow> PreviewRows
    {
        get
        {
            var beforeAmount = Current?.EffectiveInstallment;
            var afterAmount  = _form.InstallmentAmount;

            yield return new PreviewRow(
                L["Contract_Installment"],
                beforeAmount is { } b ? Money(b) : "—",
                afterAmount  is { } a ? Money(a) : "—",
                beforeAmount != afterAmount);

            yield return new PreviewRow(
                L["Contract_Interval"],
                Current is null ? "—" : IntervalLabel(Current.IntervalMonths),
                IntervalLabel(_form.IntervalMonths),
                Current?.IntervalMonths != _form.IntervalMonths);

            var beforeLeft = RemainingCount(Current?.InstallmentCount);
            var afterLeft  = RemainingCount(_form.InstallmentCount);

            yield return new PreviewRow(
                L["Revision_Remaining"],
                beforeLeft?.ToString(CultureInfo.CurrentCulture) ?? "∞",
                afterLeft?.ToString(CultureInfo.CurrentCulture) ?? "∞",
                beforeLeft != afterLeft);

            yield return new PreviewRow(
                L["Revision_LastDue"],
                LastDue(Current?.InstallmentCount, Current?.IntervalMonths ?? 1),
                LastDue(_form.InstallmentCount, _form.IntervalMonths),
                true);

            // Итог считается только когда известно и число платежей, и сумма — иначе
            // это было бы придуманное число.
            var beforeTotal = beforeLeft is { } bl && beforeAmount is { } ba ? bl * ba : (decimal?)null;
            var afterTotal  = afterLeft  is { } al && afterAmount  is { } aa ? al * aa : (decimal?)null;

            yield return new PreviewRow(
                L["Revision_RemainingTotal"],
                beforeTotal is { } bt ? Money(bt) : "—",
                afterTotal  is { } at ? Money(at) : "—",
                beforeTotal != afterTotal);
        }
    }

    private int? RemainingCount(int? total)
        => total is { } t ? Math.Max(t - InstallmentsPaid, 0) : null;

    private string LastDue(int? count, int intervalMonths)
    {
        if (count is not { } total) return "—";

        var remaining = Math.Max(total - InstallmentsPaid, 0);
        if (remaining == 0) return "—";

        var last = _form.EffectiveFrom.AddMonths((remaining - 1) * intervalMonths);
        return last.ToString("d", CultureInfo.CurrentCulture);
    }

    private string IntervalLabel(int months) => ContractFormat.IntervalLabel(L, months);

    private string Money(decimal amount)
        => $"{amount.ToString("N2", CultureInfo.CurrentCulture)} {ContractFormat.CurrencySymbol(Currency)}";
}
