@* Add/edit recurring rule dialog for one equipment. Owns the save call;
   parents open it via @ref (OpenAdd/OpenEdit) and reload on OnSaved. *@
@namespace HomeGuard.Client.Common
@inject RecurringRuleApiClient Api
@inject IStringLocalizer<Strings> L

<MudDialog @bind-Visible="_visible">
    <TitleContent>@(_editId.HasValue ? L["Rule_Edit"] : L["Rule_SetUp"])</TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_form.Title" Label=@(L["Service_Title"]) Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="_form.IntervalDays" Label=@(L["Rule_IntervalDaysLabel"])
                                 HelperText=@(L["Rule_IntervalHelp"]) />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="_form.IntervalMeter"
                                 Label=@(IntervalMeterLabel)
                                 HelperText=@(L["Rule_IntervalHelp"]) />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="_form.MaterializeDaysAhead" Label=@(L["Rule_MaterializeDays"]) />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="_form.PredictionsAhead" Label=@(L["Rule_PredictionsAhead"]) />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch @bind-Value="_form.AnchorToPurchaseDate" Color="Color.Primary" Label=@(L["Rule_AnchorToPurchase"]) />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @L["Rule_AnchorToPurchaseHelp"]
                </MudText>
            </MudItem>
            @if (_editId.HasValue)
            {
                <MudItem xs="12">
                    <MudSwitch @bind-Value="_form.IsActive" Color="Color.Primary" Label=@(L["Rule_Active"]) />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _visible = false">@L["Common_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveAsync" Disabled="_saving">@L["Common_Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public Guid EquipmentId { get; set; }

    /// <summary>Meter unit shown in the interval label.</summary>
    [Parameter] public string? MeterUnit { get; set; }

    /// <summary>The created/updated rule, or null if the API returned nothing.</summary>
    [Parameter] public EventCallback<RecurringRuleDto?> OnSaved { get; set; }

    private bool  _visible;
    private bool  _saving;
    private Guid? _editId;
    private RecurringRuleFormModel _form = new();

    // MeterUnit — слово пользователя, не переводится; подставляется в переведённую подпись.
    private string IntervalMeterLabel =>
        MeterUnit is { Length: > 0 } u ? $"{L["Rule_IntervalMeterLabel"]} ({u})" : L["Rule_IntervalMeterLabel"];

    /// <summary>Opens for a new rule, optionally prefilled with a service record's title.</summary>
    public void OpenAdd(string? title = null)
    {
        _editId  = null;
        _form    = new RecurringRuleFormModel { Title = title ?? string.Empty };
        _visible = true;
        StateHasChanged();
    }

    public void OpenEdit(RecurringRuleDto r)
    {
        _editId = r.Id;
        _form = new RecurringRuleFormModel
        {
            Title                = r.Title,
            IntervalDays         = r.IntervalDays,
            IntervalMeter        = r.IntervalMeter,
            MaterializeDaysAhead = r.MaterializeDaysAhead,
            PredictionsAhead     = r.PredictionsAhead,
            AnchorToPurchaseDate = r.AnchorToPurchaseDate,
            IsActive             = r.IsActive,
        };
        _visible = true;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var result = _editId.HasValue
            ? await Api.UpdateAsync(_editId.Value, new UpdateRecurringRuleDto(
                _form.Title, _form.IntervalDays, _form.IntervalMeter,
                _form.MaterializeDaysAhead, _form.PredictionsAhead,
                _form.AnchorToPurchaseDate, _form.IsActive))
            : await Api.CreateAsync(new CreateRecurringRuleDto(
                EquipmentId, _form.Title, _form.IntervalDays, _form.IntervalMeter,
                _form.MaterializeDaysAhead, _form.PredictionsAhead, _form.AnchorToPurchaseDate));
        _saving  = false;
        _visible = false;
        await OnSaved.InvokeAsync(result);
    }
}
