  // Base appsettings.json points Fido2 at the production domain (homeguard.local),
  // with no Development override — WebAuthn checks the browser's origin against this
  // list exactly, so a local https://localhost:5500 was always going to be rejected by
  // the passkey ceremony itself, on top of the cookie/CORS issue. "localhost" gets a
  // WebAuthn special case IP addresses don't reliably get, so use that host, not 127.0.0.1.
  "Fido2": {
    "ServerDomain": "localhost",
    "Origins": [
      "https://localhost:5500"
    ]
  },

  "Blob": {
    "LocalPath": "./dev-blobs"
  },

  "WebPush": {
    "VapidPublicKey": "BBFPFPxyfu1LsS77JwaDi3TdN0voZBZNmwB300lTHC1JYhRBF3EdPPPdn1HI8NqA4t6r1g31iyy_G0e44PC6SC8",
    "VapidPrivateKey": "KJ7XGR8kePu7IOnNNMiG0sH2MhEhDlGOpoGKFVZecTk",
    "VapidSubject": "mailto:admin@homeguard.local"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "HomeGuard": "Debug"
    }
  },

  // Turns up the verbosity on useful namespaces without touching production.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        // SQL queries — very useful when debugging data issues locally
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Migrations": "Debug",

        // See every Kestrel bind event
        "Microsoft.AspNetCore.Server.Kestrel": "Debug",

        // See SignalR hub connection lifecycle
        "Microsoft.AspNetCore.SignalR": "Debug",

        // See Blazor circuit create/dispose
        "Microsoft.AspNetCore.Components.Server": "Debug",

        // See the startup card details
        "HomeGuard.Diagnostics": "Debug",

        // Everything else from the app at Debug
        "HomeGuard": "Debug",

        // Keep framework noise at Warning so it doesn't drown your own logs
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions": "Warning",
        "System": "Warning"
      }
    }
  }

}
