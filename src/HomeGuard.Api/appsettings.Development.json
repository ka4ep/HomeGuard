  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "HomeGuard": "Debug"
    }
  },

  // Turns up the verbosity on useful namespaces without touching production.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        // SQL queries — very useful when debugging data issues locally
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Migrations": "Debug",

        // See every Kestrel bind event
        "Microsoft.AspNetCore.Server.Kestrel": "Debug",

        // See SignalR hub connection lifecycle
        "Microsoft.AspNetCore.SignalR": "Debug",

        // See Blazor circuit create/dispose
        "Microsoft.AspNetCore.Components.Server": "Debug",

        // See the startup card details
        "HomeGuard.Diagnostics": "Debug",

        // Everything else from the app at Debug
        "HomeGuard": "Debug",

        // Keep framework noise at Warning so it doesn't drown your own logs
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions": "Warning",
        "System": "Warning"
      }
    }
  }

}
