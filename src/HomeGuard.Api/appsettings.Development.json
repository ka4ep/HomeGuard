{
  "ConnectionStrings": {
//    "DefaultConnection": "Data Source=C:\\Sync\\HomeGuard\\db\\homeguard-dev.db"
    "DefaultConnection": "Data Source=W:\\Projects\\HomeGuard.db\\homeguard-dev.db"
  },

  "Cors": {
    "Origins": [
      "http://192.168.31.227:5010",
      "https://192.168.31.227:5010",
      "http://127.0.0.1:5010",
      "http://127.0.0.1:5000",
      "https://127.0.0.1:5001",
      "https://localhost:7010",
      "http://127.0.0.1:5555"
    ]
  },

  // Skips the passkey ceremony (see AuthEndpoints.DevLogin) — for when the platform
  // authenticator can't create a resident key at all, e.g. over RDP. This route does
  // not exist unless the environment is Development *and* this is true, so flip it
  // off here (or just delete the line) rather than trust remembering to before anything
  // resembling a real deployment.
  "Auth": {
    "DevBypassEnabled": true
  },

  // Base appsettings.json points Fido2 at the production domain (homeguard.local), with
  // no Development override — WebAuthn compares the browser's origin against this list
  // exactly, so passkey registration would be refused by the ceremony itself locally.
  //
  // ServerDomain is the WebAuthn Relying Party ID and must match the *host* in the
  // address bar. Browsers treat "localhost" and "127.0.0.1" as different RP IDs, so a
  // passkey registered on one will not be offered on the other — pick one host and stay
  // on it. This is set up for 127.0.0.1; switch both values together to use localhost.
  "Fido2": {
    "ServerDomain": "127.0.0.1",
    "Origins": [
      "https://127.0.0.1:5500",
      "https://localhost:5500"
    ]
  },

  "Blob": {
    "LocalPath": "./dev-blobs"
  },

  "WebPush": {
    "VapidPublicKey": "BBFPFPxyfu1LsS77JwaDi3TdN0voZBZNmwB300lTHC1JYhRBF3EdPPPdn1HI8NqA4t6r1g31iyy_G0e44PC6SC8",
    "VapidPrivateKey": "KJ7XGR8kePu7IOnNNMiG0sH2MhEhDlGOpoGKFVZecTk",
    "VapidSubject": "mailto:admin@homeguard.local"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "HomeGuard": "Debug"
    }
  },

  // Turns up the verbosity on useful namespaces without touching production.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        // SQL queries — very useful when debugging data issues locally
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Migrations": "Debug",

        // See every Kestrel bind event
        "Microsoft.AspNetCore.Server.Kestrel": "Debug",

        // See SignalR hub connection lifecycle
        "Microsoft.AspNetCore.SignalR": "Debug",

        // See Blazor circuit create/dispose
        "Microsoft.AspNetCore.Components.Server": "Debug",

        // See the startup card details
        "HomeGuard.Diagnostics": "Debug",

        // Everything else from the app at Debug
        "HomeGuard": "Debug",

        // Keep framework noise at Warning so it doesn't drown your own logs
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions": "Warning",
        "System": "Warning"
      }
    }
  }

}
